+            {"resourceType":"QuestionnaireResponse","id":"%s","questionnaire":"http://example.org/Q|V1",
+             "status":"completed","subject":{"reference":"Patient/patientId"},"authored":"2026-01-04T00:00:00Z",
+             "item":[{"linkId":"%s","answer":[{"valueBoolean":false}]}]}
