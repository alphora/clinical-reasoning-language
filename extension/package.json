{
  "name": "crl-language-support",
  "displayName": "Clinical Reasoning Language Support",
  "description": "Inject CRL keyword highlighting into CRL Markdown files (.crl) while preserving Markdown behavior.",
  "version": "0.1.0",
  "publisher": "smiledigitalhealth",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alphora/clinical-reasoning-language.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.crl-injection",
        "path": "./syntaxes/crl-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "language": "markdown"
      }
    ]
  },
  "scripts": {
    "build:crl": "npm --prefix .. run build",
    "typecheck": "tsc -p tsconfig.json",
    "compile": "npm run typecheck && node esbuild.js",
    "selftest": "node dist/mcp-server.js --selftest",
    "selftest:fixture": "node dist/mcp-server.js --selftest --file ../src/tests/regression/testdata/clinical-reasoning-language-example.crl",
    "pretest:mcp": "npm run compile",
    "test:mcp": "node src/mcp-server.test.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.3",
    "zod": "^4.4.3"
  }
}
