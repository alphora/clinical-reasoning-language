{
  "scopeName": "source.crl-injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "comment.line.double-slash.crl",
      "match": "(?<!:)//.*$"
    },
    {
      "name": "comment.block.crl",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.crl",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.backtick.crl",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "entity.name.type.crl",
      "match": "(?<!\\buse\\s)(?<!\\brecommend\\s)\\b(decision|activity|concept|terminology)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.flow.crl",
      "match": "(?<![\\w`\"])\\b(recommend activity|use decision)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.structure.crl",
      "match": "(?<![\\w`\"])\\b(when|end when|then)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.operator.logical.crl",
      "match": "(?<![\\w`\"])\\b(or|and|any|all|\\)|\\()\\b(?![\\w`\"])"
    },
        {
      "name": "keyword.operator.parens.crl",
      "match": "\\(|\\)"
    },
    {
      "name": "keyword.operator.negate.crl",
      "match": "(?<![\\w`\"])\\b(not|do not perform)\\b(?![\\w`\"])"
    },
    {
      "name": "variable.language.element.crl",
      "match": "(?<![\\w`\"])\\b(is|meta is|type is|valuetype is|evidence is|inferred from|apply pattern|request|with|because|valueset|system|code|coded from)\\b(?![\\w`\"])"
    }
  ],
  "uuid": "cc3b5b42-2f43-4fa4-94cc-b2fae909c22a",
  "__readme_token_color_customizations_snippet__": {
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": "entity.name.type.crl",
          "settings": {
            "foreground": "#9CDCFE",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.control.flow.crl",
          "settings": {
            "foreground": "#569CD6"
          }
        },
        {
          "scope": "keyword.control.structure.crl",
          "settings": {
            "foreground": "#C586C0"
          }
        },
        {
          "scope": "keyword.operator.logical.crl",
          "settings": {
            "foreground": "#ffd700"
          }
        },
                {
          "scope": "keyword.operator.parens.crl",
          "settings": {
            "foreground": "#ffd700"
          }
        },
        {
          "scope": "keyword.operator.negate.crl",
          "settings": {
            "foreground": "#D16969"
          }
        },
        {
          "scope": "variable.language.element.crl",
          "settings": {
            "foreground": "#569CD6"
          }
        },
        {
          "scope": "comment.line.double-slash.crl",
          "settings": {
            "foreground": "#6A9955",
            "fontStyle": "italic"
          }
        },
        {
          "scope": "string.quoted.double.crl",
          "settings": {
            "foreground": "#CE9178"
          }
        },
        {
          "scope": "comment.block.crl",
          "settings": {
            "foreground": "#6A9955"
          }
        },
        {
          "scope": "string.quoted.backtick.crl",
          "settings": {
            "foreground": "#DCDCAA"
          }
        }
      ]
    }
  }
}