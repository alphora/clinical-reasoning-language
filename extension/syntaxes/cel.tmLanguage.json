{
  "scopeName": "source.crl-cel",
  "patterns": [
    {
      "name": "comment.line.number-sign.crl",
      "match": "^\\s*#.*$"
    },
    {
      "name": "comment.line.double-slash.crl",
      "match": "(?<!:)//.*$"
    },
    {
      "name": "comment.block.crl",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.crl",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.backtick.crl",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "keyword.control.import.crl",
      "match": "(?<![\\w`\"])\\b(library|covers|include)\\b(?![\\w`\"])"
    },
    {
      "name": "entity.name.type.crl",
      "match": "(?<![\\w`\"])\\b(fact|case)\\b(?![\\w`\"])"
    },
    {
      "name": "variable.language.element.crl",
      "match": "(?<![\\w`\"])\\b(subject is|encounter is|anchor is|anchor|fact is|result is)\\b(?![\\w`\"])"
    },
    {
      "name": "variable.language.element.crl",
      "match": "(?<![\\w`\"])\\b(name is|birth date is|code is|date is|value is|stage is|defined by|description is|because)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.flow.crl",
      "match": "(?<![\\w`\"])\\b(with absent intent|with negative intent|absent intent|negative intent)\\b(?![\\w`\"])"
    },
    {
      "name": "variable.language.element.crl",
      "match": "(?<![\\w`\"])\\b(at anchor|at|on|now|is|as)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.flow.crl",
      "match": "(?<![\\w`\"])\\b(based on|part of|during encounter|requested by|performed by|not done because)\\b(?![\\w`\"])"
    },
    {
      "name": "constant.language.boolean.cel",
      "match": "(?<![\\w`\"])\\b(true|false)\\b(?![\\w`\"])"
    },
    {
      "name": "constant.numeric.cel",
      "match": "\\b\\d{4}-\\d{2}-\\d{2}\\b|\\b\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "support.constant.time-unit.cel",
      "match": "(?<![\\w`\"])\\b(years|year|months|month|weeks|week|days|day|hours|hour|minutes|minute|seconds|second|milliseconds|millisecond)\\b(?![\\w`\"])"
    }
  ]
}
