// Clinical Practice Guideline Language (CPGL)
/*
IS case sensitive.
NOT whitespace sensitive.
NOT indentation sensitive.
Quoted strings cannot contain escape characters.
Quoted strings (not in comments) are identifiers.
The inferred value descibes concept derivation using logical operators and references, indicating how those referenced concepts collectively infer the target concept, not as a stricly evaluatable Boolean formula.
The inferred value can have any number of concept identifiers.
The keywords "any/all" are optional (if not present, defaults to any).
The keyword "of" for activity is optional.
One of either the keywords "unknown" or "system/code" are required for terminology.
A file can have any number of decision, terminology, activity, concept.
The example includes all options for valid statements.
Anything not identified as optional here is required.
*/

decision "IMMZ.D2.D5.Measles":
    when "Measles Routine Immunization Schedule Incomplete" then: //when references a concept
        when "No Primary Series Doses Administered" then:
            any: //applies to list items
            when "Client Age Less Than 12 Months" then do "Indicate". //do references an activity
            when "Last Live Vaccine Administered Within 4 Weeks" then use "Elderly Based". //use references a decision
        done 
        when "Client Is Due For MCV12" then do "Vaccinate".
    done
    when "One Primary Series Dose Administered" then:
        all:
        when "Client Age Less Than 15 Months" then do "Indicate".
        when "Last Live Vaccine Administered Within 4 Weeks" then use "Elderly Based".
        when "Client Is Due For MCV12" then do "Vaccinate".
    done
    when "Two Primary Series Doses Administered" then do "Indicate".
done

decision "Elderly Based":
    //defaults to any
    when "Client Age Greater Than 60" then do "Indicate".
    when "Client Age Less Than 60" then:
        do "Vaccinate". 
        do "another thing".
        do "somthing else".
    done
    when "Client Age Greater Than 60" then:
        use "Elderly Based".
        use "IMMZ.D2.D5.Measles".
    done
done

terminology "some terminology" unknown.

terminology "Colonoscopy" system "http://snomed.info/sct" code "73761001".

activity "Vaccinate" perform Immunization. //Immunization is an ACTIVITY_TYPE

activity "Indicate" perform ProposeDiagnosis of "Colonoscopy". //of references a terminology

concept "Most Recent BMI":
    type Observation //Observation is a CONCEPT_TYPE
    valuetype boolean //boolean is a CONCEPT_VALUE_TYPE
    pattern "some pattern"
    provenance "some provenance"
    inferred:
        ("Most Recent Height" and "Most Recent Weight"). //"Most Recent Height" (and others) is a reference to another concept
        ("BMI as a Condition" or "BMI as a Observation").
done

// additional concepts...

/*
keywords:
decision
when
then
done
any
do
use
all
activity
unknown
system
code
perform
of
concept
type
valuetype
terminology
pattern
provenance
inferred
and
or

punctuation:
:
.
(
)

tokens (non keyword/punctuation):
STRING
COMMENT
COMMENT_BLOCK
ACTIVITY_TYPE
CONCEPT_TYPE
CONCEPT_VALUE_TYPE
*/

/*
ACTIVITY_TYPE:
      'AdministerMedication'
    | 'CollectInformation'
    | 'Communication'
    | 'DispenseMedication'
    | 'DocumentMedication'
    | 'Enrollment'
    | 'GenerateReport'
    | 'Hold'
    | 'Immunization'
    | 'MedicationRequest'
    | 'ProposeDiagnosis'
    | 'RecordDetectedIssue'
    | 'RecordInference'
    | 'ReportFlag'
    | 'Resume'
    | 'ServiceRequest'
    | 'Stop'
    ;
*/

/*
CONCEPT_TYPE:
      'Communication'
    | 'CommunicationRequest'
    | 'Condition'
    | 'QuestionnaireTask'
    | 'QuestionnaireResponse'
    | 'MedicationRequest'
    | 'MedicationDispense'
    | 'MedicationAdministration'
    | 'MedicationStatement'
    | 'ImmunizationRequest'
    | 'Immunization'
    | 'ServiceRequest'
    | 'Procedure'
    | 'Observation'
    ;
*/

/*
CONCEPT_VALUE_TYPE:
      'Quantity'
    | 'CodeableConcept'
    | 'string'
    | 'boolean'
    | 'integer'
    | 'Range'
    | 'Ratio'
    | 'SampledData'
    | 'time'
    | 'dateTime'
    | 'Period'
    | 'Attachment'
    ;
*/


casefeature "Most Recent Height"
    casefeaturecode "casefeature-height"
    fhirtype Observation
    profileurl "http://somecfprofile2-uri"
    valuetype Quantity

casefeature "Most Recent Weight"
    casefeaturecode "casefeature-weight"
    fhirtype Observation
    profileurl "http://somecfprofile2-uri"
    valuetype Quantity


pattern "some pattern"
    [ "GreatestInTheLast(), "MostRecent(arg1, arge)" ]

// this is where I would put it?
// text! for provenance
// description?
casefeature "has obesity"
    casefeaturecode "casefeature-bmi-gt-25"
    fhirtype Observation
    profileurl "http://somecfprofile1-uri"
    valuetype boolean
    expression (
        "casefeature bmi>25"
        OR 
        "calculated bmi > 25"
    )

casefeature "casefeature bmi>25"
    casefeaturecode "casefeature-bmi-gt-25"
    fhirtype Observation
    profileurl "http://somecfprofile1-uri"
    valuetype boolean

casefeature "casefeature height"
    casefeaturecode "casefeature-height"
    fhirtype Observation
    profileurl "http://somecfprofile2-uri"
    valuetype Quantity

casefeature "casefeature weight"
    casefeaturecode "casefeature-weight"
    fhirtype Observation
    profileurl "http://somecfprofile2-uri"
    valuetype Quantity

casefeature "some other case feature"
    casefeaturecode "some-other-case-feature"
    fhirtype Observation
    profileurl "http://somecfprofile3-uri"
    valuetype Quantity
