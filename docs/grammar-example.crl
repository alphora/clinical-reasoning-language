// Clinical Reasoning Language (CRL)
/*
IS case sensitive.
NOT whitespace sensitive.
NOT indentation sensitive.
Quoted strings cannot contain escape characters.
Quoted strings (not in comments) are identifiers.
The inferred value describes concept derivation using logical operators and references, indicating how those referenced concepts collectively infer the target concept, not as a strictly evaluatable Boolean formula.
The inferred value can have any number of concept identifiers.
The keywords "any/all" are optional (if not present, defaults to any).
The keyword "with" for activity is optional.
The keyword "evidence" for concept is optional.
One of either the keywords "inferred from" or "coded from" are required for concept.
One of either the keywords "valueset", `` (unknown) or "system/code" are required for terminology.
A crl can have any number of decision, terminology, activity, concept.
The example includes all options for valid statements.
Anything not identified as optional here is required.
*/

decision "IMMZ.D2.D5.Measles":
    when "Measles Routine Immunization Schedule Incomplete" then: //when references a concept
        any: //applies to list items
        when "No Primary Series Doses Administered" then:
            //defaults to any
            when "Client Age Less Than 12 Months" then do "Indicate". //do references an activity
            when "Last Live Vaccine Administered has had in 4 Weeks" then use "Elderly Based". //use references a decision
            //Note: defaults to "Not able to determine a recommendation"?
        done 
        when "Client Is Due For MCV12" then do "Vaccinate".
    done
    when "One Primary Series Dose Administered" then:
        all:
        when "Client Age Less Than 15 Months" then do "Indicate".
        when "Last Live Vaccine Administered has had in 4 Weeks" then use "Elderly Based".
        when "Client Is Due For MCV12" then do "Vaccinate".
    done
    when "Two Primary Series Doses Administered" then do "Indicate".
done

decision "Elderly Based":
    when "Client Age Greater Than 60" then do "Indicate".
    when "Client Age Less Than 60" then:
        do "Vaccinate". 
        do "another thing".
        do "something else".
    done
    when "Client Age Greater Than 60" then:
        when "Most Recent BMI" then:
            use "Some Other Decision". //Validator prevents cycles
            use "Some Other Other Decision".
        done
    done
done

terminology "BMI Range as a Condition" ``.

terminology "BMI as an Observation" valueset `BMI as an Observation`.

terminology "Height Valueset" valueset `height valueset`. 

terminology "Weight Valueset" valueset `weight valueset`. 

terminology "some terminology" ``.

terminology "Colonoscopy" system `http://snomed.info/sct` code `73761001`.

activity "Vaccinate" perform CPGImmunizationRequest. // CPGImmunizationRequest is an ACTIVITY_TYPE

activity "Indicate" perform CPGProposeDiagnosis with "Colonoscopy". // with references a terminology (or string)

activity "another thing" perform CPGCommunicationRequest with `cql:Some CQL` because `it's the right thing to do`. //with references a string (or terminology)

// comments go into the auto generated README and, CQL when applicable
concept "Most Recent BMI":
    type is Observation. //Observation is a CONCEPT_TYPE
    valuetype is boolean. //boolean is a CONCEPT_VALUE_TYPE
    evidence is `It's some evidence`.
    // gets a default local domain `coded from`
    inferred from "BMI" apply pattern `Most Recent(this, lookbackMonths)`. //"Most Recent" is a reference to a CQL expression (that will be resolved by the parser) and is optional.  "BMI" is a reference to another concept.
done

concept "BMI":
    type is Observation.
    valuetype is Quantity.
    inferred from ("BMI Range as a Condition" or "BMI as an Observation" or "Calculated BMI").
done

concept "BMI Range as a Condition":
    type is Condition.
    valuetype is CodeableConcept.
    coded from "BMI Range as a Condition". //"BMI Range as a Condition" is a reference to a terminology
done

concept "BMI as an Observation":
    type is Observation.
    valuetype is Quantity.
    coded from "BMI as an Observation".
done

concept "Calculated BMI":
    type is Observation.
    valuetype is Quantity.
    //calculate using (weight/height^2)
    inferred from ("Patient Height" and "Patient Weight").
done

concept "Patient Height":
    type is Observation.
    valuetype is integer.
    coded from "Height Valueset".
done

concept "Patient Weight":
    type is Observation.
    valuetype is integer.
    coded from "Weight Valueset".
done

concept "Client Age Greater Than 60":
    type is Observation.
    valuetype is boolean.
    inferred from 
    (
        (
            ("a" and "b")
            or (
                ("c" and "d")
                and not ("e" or "f")
            )
        )
        or (
            ("x" or "y")
            and "z"
        )
        or "k"
        or "l"
    ).
done

/**
This section (summary and metric) is under development.
**/
summary "some thing":
    collects 
    ("Weight Change" or "Urine Out")
        or (
            ("Net IO's" or "JVP")
            or ("O2 Sat" or "Potassium")
        ).
done

summary "some other thing":
    collects 
    (
        (
            ("a" and "b")
            or (
                ("c" and "d")
                and ("e" or "f")
            )
        )
        or (
            ("x" or "y")
            and "z"
        )
        or "k"
        or "l"
    ).
done

// measure
metric "Colorectal Screening":
    scoring is continuous-variable.  //optional
    improvement is increase. // optional
    evidence `because this fixes things` //optional
    based on ("Initial Population" and "Numerator" and "Denominator").
done

metric "Initial Population"
    based on ("Qualifying Encounter" and "Minimum Age").
done

metric "Denominator"
    based on ("Initial Population").
done

metric "Numerator"
    based on ("Colorectal Exam Within 10 Years").
done

/*
keywords:
activity
all
and
any
apply
because
code
coded
concept
decision
done
do
error
evidence
from
has
inferred
not
or
pattern
perform
system
terminology
then
type
use
valuetype
valueset
when
with

punctuation:
:
.
(
)

tokens (non keyword/punctuation):
QUOTED_STRING
BACKTICK_STRING
COMMENT
COMMENT_BLOCK
ACTIVITY_TYPE
CONCEPT_TYPE
CONCEPT_VALUE_TYPE
*/

