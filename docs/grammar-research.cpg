
<newline> ::= "\n"
<indent> ::= "   "
<decision> ::= decision <identifier><newline><indent><rule>
<rule> ::= (all | any) when <casefeaturereference> then<newline><indent> (do <actionreference> | <rule> | use <decisionreference>) // default is any, applicabilityBehavior
<casefeaturcasefeaturereference> ::= <identifier> // reference to a casefeature definition
<actionreference> ::= <identifier> // reference to action definition
<identifier> ::= <string> // string is a quoted string
<action> ::= action <identifier>
<casefeature> ::= casefeature <identifier><newline><indent><fhirtype>
<fhirtype> ::= (Observation | Condition)

decision "IMMZ.D2.D5.Measles"
	when "Measles Routine Immunization Schedule Incomplete" then
		when "No Primary Series Doses Administered" then
			any
			when "Client Age Less Than 12 Months" then 
				do "Indicate"
			when "Last Live Vaccine Administered Within 4 Weeks" then 
				use "Elderly Based"
			when "Client Is Due For MCV12" then 
				do "Vaccinate"
		when "One Primary Series Dose Administered" then
			all
			when "Client Age Less Than 15 Months" then 
				do "Indicate"
			when "Last Live Vaccine Administered Within 4 Weeks" then 
				use "Elderly Based"
			when "Client Is Due For MCV12" then 
				do "Vaccinate"
		when "Two Primary Series Doses Administered" then 
			do "Indicate"

decision "Elderly Based"
	when "Client Age Greater Than 60" then
		do "Indicate"
	when "Client Age Less Than 60" then
		do "Vaccinate"

action "Indicate"
	fhirtype ServiceRequest

action "Vaccinate"
	fhirtype MedicationRequest

casefeature "Measles Routine Immunization Schedule Incomplete"
	code "measles-routine-immunization-schedule-incomplete"
	fhirtype Condition 
	url "http://someothercfprofile-uri"
	valuetype boolean

casefeature "Last Live Vaccine Administered Within 4 Weeks"
	code "last-live-vaccine-administered"
	fhirtype Observation 
	url "http://somecfprofile-uri"
	valuetype dateTime

	(
		casefeature bmi>25
		OR
		(
			casefeature height
			AND
			casefeature weight
		)
	)

// other case features

casefeature height

if "Measles Routine Immunization Schedule Incomplete" then
	if "No Primary Series Doses Administered" then
		if "Client Age Less Than 12 Months" then
			Indicate
		if not "Client Age Less Than 12 Months" then
			if "Last Live Vaccine Administered Within 4 Weeks" then
				Indicate
			if not "Last Live Vaccine Administered Within 4 Weeks" then
				if "Client Is Due For MCV12" then
					Vaccinate
