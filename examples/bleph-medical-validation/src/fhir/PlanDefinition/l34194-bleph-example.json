                  "title": "Upper Blepharoplasty Evidence",
                  "description": "Upper Blepharoplasty Evidence",
                  "code": [
                    {
                      "coding": [
                        {
                          "system": "http://hl7.org/fhir/uv/cpg/CodeSystem/cpg-common-process-cs",
                          "code": "guideline-based-care"
                        }
                      ]
