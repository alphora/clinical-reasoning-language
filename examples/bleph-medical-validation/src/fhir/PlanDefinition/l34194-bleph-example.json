                    }
                  ],
                  "input": [
                    {
                      "extension": [
                        {
                          "url": "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-input-text",
                          "valueString": "Which skin finding is documented for upper blepharoplasty?"
                        },
                        {
                          "url": "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-input-description",
                          "valueMarkdown": "Assess the affected eye. Pseudo-MRD measures from the corneal light reflex to the overhanging skin margin, not the actual eyelid margin. Side-gaze obstruction must be caused by predominantly medial or lateral redundant tissue."
                        }
                      ],
                      "type": "Observation",
                      "profile": [
                        "http://example.org/crl/StructureDefinition/l34194-bleph-example-upper-eyelid-skin-finding"
                      ]
                    },
                    {
                      "extension": [
                        {
                          "url": "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-input-text",
                          "valueString": "Do the photographs document the qualifying skin finding?"
                        },
                        {
                          "url": "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-input-description",
                          "valueMarkdown": "Photographs must show the same eye and finding recorded above, with sufficient size and detail, patient name and date, and no distorting head or camera tilt. Include frontal and lateral views; oblique views are needed only when the finding is not adequately shown otherwise. Use primary gaze unless another gaze is required to demonstrate the deficit."
                        }
                      ],
                      "type": "Observation",
                      "profile": [
                        "http://example.org/crl/StructureDefinition/l34194-bleph-example-upper-blepharoplasty-photographs-documented"
                      ]
