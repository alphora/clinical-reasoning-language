{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alphora/mv-spaces-medical-policy/launcher/schema/catalog.schema.json",
  "title": "KALM AI Release Notes catalog, v1",
  "description": "release-notes/catalog.json at the provider extension's root: UTF-8, no BOM, strict JSON, at most 262144 bytes. Rules JSON Schema cannot express (ordering, uniqueness, version bounds, file existence and type, signatures, dimensions, size totals) are normative in launcher/CONTRACT.md and checked by launcher/validate.cjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baselineVersion",
    "releases"
  ],
  "properties": {
    "baselineVersion": {
      "description": "Required, exclusive history boundary: the catalog lists every release after it that has user-visible notes. Plain MAJOR.MINOR.PATCH.",
      "$ref": "#/$defs/release-version"
    },
    "deployedBaselineVersion": {
      "description": "Informational. Never read by the launcher.",
      "$ref": "#/$defs/release-version"
    },
    "releases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
    },
    "png": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\.png$"
    },
    "webm": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\.webm$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "title",
        "features"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/release-version"
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "maxLength": 120
            }
          ]
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "maxLength": 120
            }
          ]
        },
        "description": {
          "description": "Plain text. One \\n is a line break; two or more start a paragraph. No \\r or other control characters. Nothing is markup; URLs are not linked.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f\\u2028\\u2029]+$"
        },
        "image": {
          "$ref": "#/$defs/png"
        },
        "video": {
          "$ref": "#/$defs/webm"
        },
        "poster": {
          "$ref": "#/$defs/png"
        },
        "alt": {
          "allOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "maxLength": 300
            }
          ]
        },
        "caption": {
          "allOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "maxLength": 300
            }
          ]
        }
      },
      "dependentRequired": {
        "image": [
          "alt"
        ],
        "video": [
          "poster",
          "alt",
          "caption"
        ],
        "poster": [
          "video"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "alt"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "image"
                ]
              },
              {
                "required": [
                  "video"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "caption"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "image"
                ]
              },
              {
                "required": [
                  "video"
                ]
              }
            ]
          }
        }
      ]
    },
    "release-version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    }
  }
}
