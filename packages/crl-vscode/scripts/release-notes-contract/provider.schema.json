{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alphora/mv-spaces-medical-policy/launcher/schema/provider.schema.json",
  "title": "KALM AI Release Notes provider descriptor, v1",
  "description": "release-notes/provider.json at the provider extension's root: UTF-8, no BOM, strict JSON, at most 4096 bytes. schemaVersion governs catalog.json too. See launcher/CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "displayName",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+$"
    },
    "version": {
      "description": "Must equal the extension's package.json version exactly (string equality).",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
