{
  "name": "crl-language-support",
  "displayName": "Clinical Reasoning Language Support",
  "description": "CRL + CEL keyword highlighting, live validation diagnostics, CRL→CQL + CEL→FHIR-JSON emit, and catalog-driven authoring help (completion + hover) for .crl / .cel Markdown files.",
  "version": "4.30.0",
  "publisher": "smiledigitalhealth",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.crl",
    "workspaceContains:**/*.cel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alphora/clinical-reasoning-language.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "crl",
        "aliases": [
          "Clinical Reasoning Language",
          "crl"
        ],
        "extensions": [
          ".crl"
        ],
        "configuration": "./syntaxes/crl.language-configuration.json"
      },
      {
        "id": "crl-cel",
        "aliases": [
          "Case Example Language",
          "CEL",
          "cel"
        ],
        "extensions": [
          ".cel"
        ],
        "configuration": "./syntaxes/cel.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crl",
        "scopeName": "source.crl",
        "path": "./syntaxes/crl.tmLanguage.json"
      },
      {
        "language": "crl-cel",
        "scopeName": "source.crl-cel",
        "path": "./syntaxes/cel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "crl.setup",
        "title": "CRL: Set up tools (MCP, CLAUDE.md, highlighting)"
      },
      {
        "command": "crl.remove",
        "title": "CRL: Remove tools (MCP, CLAUDE.md, highlighting)"
      },
      {
        "command": "crl.refreshProjectCache",
        "title": "CRL: Refresh project cache (re-scan all .crl files)"
      },
      {
        "command": "crl.runScenario",
        "title": "CRL: Run Scenario",
        "icon": "$(play)"
      },
      {
        "command": "crl.showProvenance",
        "title": "CRL: Show Provenance",
        "icon": "$(checklist)"
      },
      {
        "command": "crl.revealProvenanceTarget",
        "title": "CRL: Reveal Provenance Target"
      },
      {
        "command": "crl.cockpit.show",
        "title": "CRL: Show Cockpit",
        "icon": "$(layout)"
      },
      {
        "command": "crl.medicalValidation.show",
        "title": "CRL: Show Medical Validation",
        "icon": "$(verified)"
      },
      {
        "command": "crl.cockpit.selectItem",
        "title": "CRL: Select Cockpit Item"
      },
      {
        "command": "crl.cockpit.next",
        "title": "CRL: Next Unit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "crl.cockpit.prev",
        "title": "CRL: Previous Unit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "crl.cockpit.openRaw",
        "title": "CRL: Open Raw Source at Locus",
        "icon": "$(go-to-file)"
      },
      {
        "command": "crl.cockpit.setPrimary",
        "title": "CRL: Set Navigator Primary Pane (Source / CRL / CEL)",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "crl.cockpit.toggleKeys",
        "title": "CRL: Toggle Correspondence Keys",
        "icon": "$(symbol-numeric)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crlCockpit",
          "title": "CRL",
          "icon": "$(law)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "crlProvenanceFindings",
          "name": "CRL Provenance",
          "when": "crl.active"
        }
      ],
      "crlCockpit": [
        {
          "id": "crlCockpitNavigator",
          "name": "Correspondence",
          "when": "crl.active"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "crl.runScenario",
          "when": "resourceExtname == .cel",
          "group": "navigation"
        },
        {
          "command": "crl.showProvenance",
          "when": "resourceExtname == .cel",
          "group": "navigation"
        },
        {
          "command": "crl.cockpit.show",
          "when": "resourceExtname == .cel",
          "group": "navigation"
        },
        {
          "command": "crl.medicalValidation.show",
          "when": "resourceExtname == .cel",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "crl.cockpit.setPrimary",
          "when": "view == crlCockpitNavigator",
          "group": "navigation@0"
        },
        {
          "command": "crl.cockpit.prev",
          "when": "view == crlCockpitNavigator",
          "group": "navigation@1"
        },
        {
          "command": "crl.cockpit.next",
          "when": "view == crlCockpitNavigator",
          "group": "navigation@2"
        },
        {
          "command": "crl.cockpit.openRaw",
          "when": "view == crlCockpitNavigator",
          "group": "navigation@3"
        },
        {
          "command": "crl.cockpit.toggleKeys",
          "when": "view == crlCockpitNavigator",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "crl.runScenario",
          "when": "resourceExtname == .cel"
        },
        {
          "command": "crl.showProvenance",
          "when": "resourceExtname == .cel"
        },
        {
          "command": "crl.revealProvenanceTarget",
          "when": "false"
        },
        {
          "command": "crl.cockpit.show",
          "when": "crl.active"
        },
        {
          "command": "crl.medicalValidation.show",
          "when": "crl.active"
        },
        {
          "command": "crl.cockpit.selectItem",
          "when": "false"
        },
        {
          "command": "crl.cockpit.next",
          "when": "crl.active"
        },
        {
          "command": "crl.cockpit.prev",
          "when": "crl.active"
        },
        {
          "command": "crl.cockpit.openRaw",
          "when": "crl.active"
        },
        {
          "command": "crl.cockpit.setPrimary",
          "when": "crl.active"
        },
        {
          "command": "crl.cockpit.toggleKeys",
          "when": "crl.active"
        }
      ]
    },
    "configuration": {
      "title": "Clinical Reasoning Language",
      "properties": {
        "crl.autoProvision": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure CRL tools (MCP server + CLAUDE.md) and highlighting when a workspace containing .crl files is opened. Use the 'CRL: Set up tools' / 'CRL: Remove tools' commands to do it manually."
        },
        "crl.cockpit.primary": {
          "type": "string",
          "enum": [
            "source",
            "crl",
            "cel"
          ],
          "default": "source",
          "scope": "window",
          "description": "The cockpit's default primary pane — which pane the Correspondence navigator walks. 'source' lists source units; 'crl' lists CRL decision nodes; 'cel' lists CEL cases. Set per-window; switch live with 'CRL: Set Navigator Primary Pane'."
        },
        "crl.cockpit.paneOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "source",
              "crl",
              "cel",
              "tree"
            ]
          },
          "default": [
            "source",
            "crl",
            "cel",
            "tree"
          ],
          "scope": "window",
          "description": "Left-to-right column order of the cockpit panes. 'source', 'crl', and 'cel' are always shown; 'tree' (the graphical decision-tree flowchart) is shown by default but can be removed from this list to hide it. Set it in User settings to persist across all projects, or in Workspace settings for one project. A malformed list is repaired automatically. Changes apply live to open panes."
        },
        "crl.cockpit.showKeys": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show the at-rest correspondence key (a per-unit number + cycled color) on each corresponding element across the cockpit's CRL / CEL panes and the navigator, so 'what links to what' is visible without selecting. Toggle live with 'CRL: Toggle Correspondence Keys'."
        },
        "crl.cockpit.failedCriteriaMode": {
          "type": "string",
          "enum": [
            "blocking",
            "all"
          ],
          "default": "blocking",
          "scope": "window",
          "description": "Which failed criteria the cockpit highlights when a failing CEL case is selected. 'blocking' (default): only the criteria that blocked the expected disposition (empty for a passing case). 'all': every evaluated-unsatisfied 'when' in the run. Toggle live with the segmented control on the cockpit's Tree pane. SHARED with the Medical Validation panel."
        },
        "crl.medical-validation.primary": {
          "type": "string",
          "enum": [
            "source",
            "cel"
          ],
          "default": "cel",
          "scope": "window",
          "description": "The Medical Validation panel's default primary pane — which pane the navigator walks. 'cel' (default) lists CEL cases (the worklist); 'source' lists source units. Set per-window; switch live with 'CRL: Set Navigator Primary Pane'."
        },
        "crl.medical-validation.paneOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "worklist",
              "source",
              "tree",
              "crl",
              "cel"
            ]
          },
          "default": [
            "worklist",
            "source",
            "tree"
          ],
          "scope": "window",
          "description": "Left-to-right column order of the Medical Validation panel's panes. 'worklist' (the CEL pane in worklist mode), 'source', and 'tree' are shown by default; 'crl' and 'cel' can be added. ('worklist' and 'cel' are the same underlying pane, so listing both keeps the first.) Set it in User settings to persist across all projects, or in Workspace settings for one project. A malformed list is repaired automatically. Changes apply live to open panes."
        },
        "crl.medical-validation.showKeys": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show the at-rest correspondence key (a per-unit number + cycled color) on each corresponding element across the Medical Validation panel's panes and the navigator, so 'what links to what' is visible without selecting. Toggle live with 'CRL: Toggle Correspondence Keys'."
        }
      }
    }
  },
  "scripts": {
    "build:crl": "npm --prefix ../crl run build",
    "typecheck": "tsc -p tsconfig.json",
    "precompile": "npm run build:crl && node scripts/check-core.cjs",
    "compile": "npm run typecheck && node esbuild.js",
    "selftest": "node dist/mcp-server.js --selftest",
    "selftest:fixture": "node dist/mcp-server.js --selftest --file ../crl/src/tests/regression/testdata/clinical-reasoning-language-example.crl",
    "pretest:mcp": "npm run compile",
    "test:mcp": "node src/mcp-server.test.mjs",
    "pretest:provision": "npm run compile",
    "test:provision": "node src/provision.test.mjs",
    "pretest:highlight": "npm run compile",
    "test:highlight": "node src/highlight.test.mjs",
    "pretest:catalog": "npm run compile",
    "test:catalog": "node src/catalog.test.mjs && node src/embedded-catalog.test.mjs",
    "pretest:concepts": "npm run compile",
    "test:concepts": "node src/concepts.test.mjs",
    "pretest:crl-patterns": "npm run compile",
    "test:crl-patterns": "node src/crl-patterns-coverage.test.mjs",
    "pretest:context-detect": "npm run compile",
    "test:context-detect": "node src/contextDetect.test.mjs",
    "pretest:find-declaration": "npm run compile",
    "test:find-declaration": "node src/findDeclaration.test.mjs",
    "pretest:project-index": "npm run compile",
    "test:project-index": "node src/projectIndex.test.mjs",
    "pretest:completion": "npm run compile",
    "test:completion": "node src/completion.test.mjs",
    "pretest:provenance-findings": "npm run compile",
    "test:provenance-findings": "node src/provenanceFindings.test.mjs",
    "pretest:provenance-viewer": "npm run compile",
    "test:provenance-viewer": "node src/provenanceViewer.test.mjs",
    "pretest:medical-validation-store": "npm run compile",
    "test:medical-validation-store": "node src/medicalValidationStore.test.mjs",
    "pretest:correspondence-engine": "npm run compile",
    "test:correspondence-engine": "node src/correspondenceEngine.test.mjs",
    "pretest:pane-reveal-coordinator": "npm run compile",
    "test:pane-reveal-coordinator": "node src/paneRevealCoordinator.test.mjs",
    "pretest:source-pane-html": "npm run compile",
    "test:source-pane-html": "node src/sourcePaneHtml.test.mjs",
    "pretest:crl-pane-html": "npm run compile",
    "test:crl-pane-html": "node src/crlPaneHtml.test.mjs",
    "pretest:flow-pane-html": "npm run compile",
    "test:flow-pane-html": "node src/flowPaneHtml.test.mjs",
    "pretest:cel-pane-html": "npm run compile",
    "test:cel-pane-html": "node src/celPaneHtml.test.mjs",
    "pretest:failed-criterion-peek": "npm run compile",
    "test:failed-criterion-peek": "node src/failedCriterionPeek.test.mjs",
    "pretest:failed-criterion-label": "npm run compile",
    "test:failed-criterion-label": "node src/failedCriterionLabel.test.mjs",
    "pretest:corr-key": "npm run compile",
    "test:corr-key": "node src/corrKey.test.mjs",
    "pretest:webview-hit": "npm run compile",
    "test:webview-hit": "node src/webviewHit.test.mjs",
    "pretest:pane-order": "npm run compile",
    "test:pane-order": "node src/paneOrder.test.mjs",
    "test:grammar": "node src/grammar.test.mjs",
    "test:package": "node src/package.test.mjs",
    "test:language-config": "node src/language-config.test.mjs",
    "test": "npm run compile && node src/mcp-server.test.mjs && node src/provision.test.mjs && node src/highlight.test.mjs && node src/catalog.test.mjs && node src/embedded-catalog.test.mjs && node src/concepts.test.mjs && node src/crl-patterns-coverage.test.mjs && node src/contextDetect.test.mjs && node src/findDeclaration.test.mjs && node src/projectIndex.test.mjs && node src/completion.test.mjs && node src/grammar.test.mjs && node src/package.test.mjs && node src/language-config.test.mjs && node src/renderScenarioHtml.test.mjs && node src/provenanceFindings.test.mjs && node src/provenanceViewer.test.mjs && node src/medicalValidationStore.test.mjs && node src/correspondenceEngine.test.mjs && node src/paneRevealCoordinator.test.mjs && node src/sourcePaneHtml.test.mjs && node src/crlPaneHtml.test.mjs && node src/flowPaneHtml.test.mjs && node src/celPaneHtml.test.mjs && node src/failedCriterionPeek.test.mjs && node src/failedCriterionLabel.test.mjs && node src/webviewHit.test.mjs && node src/corrKey.test.mjs && node src/paneOrder.test.mjs && node test/oracle/check.mjs",
    "vscode:prepublish": "npm run build:crl && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smile-digital-health/crl": "*",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.3",
    "zod": "^4.4.3"
  }
}
