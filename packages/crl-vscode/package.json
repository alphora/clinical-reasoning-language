{
  "name": "crl-language-support",
  "displayName": "Clinical Reasoning Language Support",
  "description": "CRL + CEL keyword highlighting, live validation diagnostics, CRL→CQL + CEL→FHIR-JSON emit, and catalog-driven authoring help (completion + hover) for .crl / .cel Markdown files.",
  "version": "4.4.0",
  "publisher": "smiledigitalhealth",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.crl",
    "workspaceContains:**/*.cel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alphora/clinical-reasoning-language.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "crl",
        "aliases": [
          "Clinical Reasoning Language",
          "crl"
        ],
        "extensions": [
          ".crl"
        ],
        "configuration": "./syntaxes/crl.language-configuration.json"
      },
      {
        "id": "crl-cel",
        "aliases": [
          "Case Example Language",
          "CEL",
          "cel"
        ],
        "extensions": [
          ".cel"
        ],
        "configuration": "./syntaxes/cel.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crl",
        "scopeName": "source.crl",
        "path": "./syntaxes/crl.tmLanguage.json"
      },
      {
        "language": "crl-cel",
        "scopeName": "source.crl-cel",
        "path": "./syntaxes/cel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "crl.setup",
        "title": "CRL: Set up tools (MCP, CLAUDE.md, highlighting)"
      },
      {
        "command": "crl.remove",
        "title": "CRL: Remove tools (MCP, CLAUDE.md, highlighting)"
      },
      {
        "command": "crl.refreshProjectCache",
        "title": "CRL: Refresh project cache (re-scan all .crl files)"
      }
    ],
    "configuration": {
      "title": "Clinical Reasoning Language",
      "properties": {
        "crl.autoProvision": {
          "type": "boolean",
          "default": true,
          "description": "Automatically configure CRL tools (MCP server + CLAUDE.md) and highlighting when a workspace containing .crl files is opened. Use the 'CRL: Set up tools' / 'CRL: Remove tools' commands to do it manually."
        }
      }
    }
  },
  "scripts": {
    "build:crl": "npm --prefix ../crl run build",
    "typecheck": "tsc -p tsconfig.json",
    "precompile": "node scripts/check-core.cjs",
    "compile": "npm run typecheck && node esbuild.js",
    "selftest": "node dist/mcp-server.js --selftest",
    "selftest:fixture": "node dist/mcp-server.js --selftest --file ../crl/src/tests/regression/testdata/clinical-reasoning-language-example.crl",
    "pretest:mcp": "npm run compile",
    "test:mcp": "node src/mcp-server.test.mjs",
    "pretest:provision": "npm run compile",
    "test:provision": "node src/provision.test.mjs",
    "pretest:highlight": "npm run compile",
    "test:highlight": "node src/highlight.test.mjs",
    "pretest:catalog": "npm run compile",
    "test:catalog": "node src/catalog.test.mjs && node src/embedded-catalog.test.mjs",
    "pretest:concepts": "npm run compile",
    "test:concepts": "node src/concepts.test.mjs",
    "pretest:crl-patterns": "npm run compile",
    "test:crl-patterns": "node src/crl-patterns-coverage.test.mjs",
    "pretest:context-detect": "npm run compile",
    "test:context-detect": "node src/contextDetect.test.mjs",
    "pretest:find-declaration": "npm run compile",
    "test:find-declaration": "node src/findDeclaration.test.mjs",
    "pretest:project-index": "npm run compile",
    "test:project-index": "node src/projectIndex.test.mjs",
    "pretest:completion": "npm run compile",
    "test:completion": "node src/completion.test.mjs",
    "test:grammar": "node src/grammar.test.mjs",
    "test:package": "node src/package.test.mjs",
    "test:language-config": "node src/language-config.test.mjs",
    "test": "npm run compile && node src/mcp-server.test.mjs && node src/provision.test.mjs && node src/highlight.test.mjs && node src/catalog.test.mjs && node src/embedded-catalog.test.mjs && node src/concepts.test.mjs && node src/crl-patterns-coverage.test.mjs && node src/contextDetect.test.mjs && node src/findDeclaration.test.mjs && node src/projectIndex.test.mjs && node src/completion.test.mjs && node src/grammar.test.mjs && node src/package.test.mjs && node src/language-config.test.mjs && node test/oracle/check.mjs",
    "vscode:prepublish": "npm run build:crl && npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smile-digital-health/crl": "*",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.3",
    "zod": "^4.4.3"
  }
}
