{
  "scopeName": "source.crl",
  "patterns": [
    {
      "name": "comment.line.number-sign.crl",
      "match": "^\\s*#.*$"
    },
    {
      "name": "comment.line.double-slash.crl",
      "match": "(?<!:)//.*$"
    },
    {
      "name": "comment.block.crl",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.crl",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "string.quoted.backtick.crl",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "entity.name.type.crl",
      "match": "(?<!\\buse\\s)(?<!\\brecommend\\s)\\b(decision|activity|concept|terminology|parameter)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.import.crl",
      "match": "(?<![\\w`\"])\\b(library|include)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.flow.crl",
      "match": "(?<![\\w`\"])\\b(recommend activity|use decision)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.applicability.crl",
      "match": "(?<![\\w`\"])\\b(any|all|first|end)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.control.structure.crl",
      "match": "(?<![\\w`\"])\\b(when|otherwise|then)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.operator.logical.crl",
      "match": "(?<![\\w`\"])\\b(or|and|sem-or|sem-and)\\b(?![\\w`\"])"
    },
    {
      "name": "keyword.operator.parens.crl",
      "match": "\\(|\\)"
    },
    {
      "name": "keyword.operator.negate.crl",
      "match": "(?<![\\w`\"])\\b(not|do not perform|sem-not)\\b(?![\\w`\"])"
    },
    {
      "name": "variable.language.element.crl",
      "match": "(?<![\\w`\"])\\b(meta is|type is|value type is|param type is|evidence is|defined as|definition is|request|with|because|valueset is|system is|code is|coded from|source representation)\\b(?![\\w`\"])"
    }
  ],
  "uuid": "cc3b5b42-2f43-4fa4-94cc-b2fae909c22a",
