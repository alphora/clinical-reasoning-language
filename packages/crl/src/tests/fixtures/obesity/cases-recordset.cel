// REFACTOR:grounded (#320, plan595): negative migration inputs paired with retired BMI policies.
// Every case must error before evaluation; these historical expected activities are not a current oracle.
library "ObesityRecordSetCases".
covers "Obesity Coverage (RecordSet)".

fact "Pat":
- name is "Pat".
- birth date is "1970-01-01".
- defined by "Patient".

fact "Obese Yes":
- date is "2026-01-01".
- value is true.
- defined by "Obesity Coverage (RecordSet)"."Obese".

fact "Obese No":
- date is "2026-01-01".
- value is false.
- defined by "Obesity Coverage (RecordSet)"."Obese".

case "obese stated true -> approve":
- subject is "Pat".
- fact is "Obese Yes".
- result is "Bariatric Surgery Coverage" is "Approve Bariatric Surgery".

case "obese stated false -> deny":
- subject is "Pat".
- fact is "Obese No".
- result is "Bariatric Surgery Coverage" is "Deny Bariatric Surgery".
// Known-wrong historical expectation: this case asserts approval with no Obese fact.
// Re-author and verify against native $apply before using it as a positive oracle.
case "obese unanswered -> no recommendation":
- subject is "Pat".
- result is "Bariatric Surgery Coverage" is "Approve Bariatric Surgery".
fact "Weight 90":
- date is "2026-05-01".
- value is 90 'kg'.
- defined by "Obesity Coverage (RecordSet)"."Weight".

fact "Height 1.7":
- date is "2026-02-01".
- value is 1.7 'm'.
- defined by "Obesity Coverage (RecordSet)"."Height".

case "computed obese -> approve":
- subject is "Pat".
- fact is "Weight 90".
- fact is "Height 1.7".
- result is "Bariatric Surgery Coverage" is "Approve Bariatric Surgery".
