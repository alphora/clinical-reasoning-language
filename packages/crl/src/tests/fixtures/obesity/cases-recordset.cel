# The acceptance truth table for the RECORDSET authoring option — the SAME table, one question.
// ⚠ Both authoring options owe this table. The models differ in how many questions they expose
// (four vs one), never in what the decision must produce. `result is` states what the case MUST
// produce; a `fail` here is the burn-down signal, never a case to re-author.
library "ObesityRecordSetCases".
covers "Obesity Coverage (RecordSet)".

fact "Pat":
- name is "Pat".
- birth date is "1970-01-01".
- defined by "Patient".

fact "Obese Yes":
- date is "2026-01-01".
- value is true.
- defined by "Obesity Coverage (RecordSet)"."Obese".

fact "Obese No":
- date is "2026-01-01".
- value is false.
- defined by "Obesity Coverage (RecordSet)"."Obese".

case "obese stated true -> approve":
- subject is "Pat".
- fact is "Obese Yes".
- result is "Bariatric Surgery Coverage" is "Approve Bariatric Surgery".

case "obese stated false -> deny":
- subject is "Pat".
- fact is "Obese No".
- result is "Bariatric Surgery Coverage" is "Deny Bariatric Surgery".

case "obese unanswered -> no recommendation":
- subject is "Pat".
- result is "Bariatric Surgery Coverage" is "Approve Bariatric Surgery".
