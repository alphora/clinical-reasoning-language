# CMS22 Blood Pressure Screening and Follow-Up
library "cms22".

// The unsuffixed file is the Quality Measure interface layer
// (IP / Denom / Numerator / Exclusions / Exceptions — what the Measure
// evaluation engine consumes). Asserted concepts, inferred derivations,
// and terminology live in cms22-asserted.crl / cms22-inferred.crl /
// cms22-concepts.crl.

// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- value type is boolean.
- defined as "cms22-Inferences"."Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Observation.
- value type is boolean.
- defined as "Initial Population".

concept "Denominator Exclusions":
- type is Observation.
- value type is CodeableConcept.
- defined as "cms22-Inferences"."Verified Hypertension As Of Qualifying Encounter".

concept "Numerator":
- type is Observation.
- value type is boolean.
- defined as
(
   "cms22-Inferences"."Normal BP Reading"
   or
   "cms22-Inferences"."Elevated BP With Followup"
   or
   "cms22-Inferences"."First HTN With Followup"
   or
   "cms22-Inferences"."Second HTN 130s With Followup"
   or
   "cms22-Inferences"."Second HTN 140+ With Followup"
).

concept "Denominator Exceptions":
- type is Observation.
- value type is boolean.
- defined as
(
   "cms22-Inferences"."BP Measurement Not Done With Reason"
   or
   "cms22-Inferences"."HTN Followup Declined By Patient"
).
