// --- Low BMI Interventions Performed ---

concept "Low BMI Procedure Justified by Underweight Diagnosis":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Procedures" justified by "cms69-ExternalPrimitives"."Underweight Diagnoses".

concept "Low BMI Follow-up Procedures Performed":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Procedures" performed.

concept "Low BMI Procedures During MP":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Procedures" during "Measurement Period".

concept "Low BMI Procedure Preceded by Underweight During MP":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "Low BMI Procedures During MP" on day of or after "Underweight Diagnoses Active".

concept "Low BMI Procedure Performed":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   (
      "Low BMI Procedure Justified by Underweight Diagnosis"
      sem-and
      "Low BMI Follow-up Procedures Performed"
   )
   sem-or
   "Low BMI Procedure Preceded by Underweight During MP"
).

concept "Low BMI Procedure Performed Exists":
- type is Procedure.
- value type is boolean.
- defined as exists ( "Low BMI Procedure Performed" ).


// --- Low BMI And Follow Up Provided ---

// `Documented Low BMI` is already Measurement-Period-scoped (see the High counterpart above);
// the former `... During MP` wrapper was a redundant `during` over a derived boolean. Removed.

concept "Low BMI And Follow Up Provided":
- type is Observation.
- value type is boolean.
- defined as
(
   "Documented Low BMI"
   and
   (
      "Low BMI Interventions Ordered"
      or
      "Low BMI Procedure Performed Exists"
   )
).


// --- BMI exam not performed with reason ---

concept "BMI Observation Not Done With Reason":
- type is Observation.
- value type is Quantity.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."BMI Observations" not done with reason ("cms69-ExternalPrimitives"."Medical Reasons" or "cms69-ExternalPrimitives"."Patient Declined Reasons").

concept "BMI Observation Same Day As Qualifying Encounter":
- type is Observation.
- value type is Quantity.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."BMI Observations" same day as "Qualifying Encounter".

// #189 Slice 2 — intersect-first. The SAME BMI observation must be BOTH not-done-with-reason AND
// same-day-as-encounter (a BMI not performed on the encounter day for a documented reason). The pre-#189
// squat emitted `exists(A) and exists(B)` (INDEPENDENT existence — a not-done BMI on one day plus a
// DIFFERENT same-day BMI would falsely satisfy it). The record `sem-and` restores the correlation
// (emits `intersect`); the determination is `exists` over it.
concept "BMI Observations Not Done On Encounter Day":
- type is Observation.
- value type is Quantity.
- shape is RecordSet.
- defined as
(
   "BMI Observation Not Done With Reason"
   sem-and
   "BMI Observation Same Day As Qualifying Encounter"
).

concept "Medical Reason Or Patient Reason For Not Performing BMI Exam":
- type is Observation.
- value type is boolean.
- defined as exists ( "BMI Observations Not Done On Encounter Day" ).


// --- BMI follow-up not documented with reason ---

concept "High BMI Follow-up Not Done With Medical Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Service Requests" not done with reason "cms69-ExternalPrimitives"."Medical Reasons".

concept "High BMI Follow-up Same Day As Qualifying Encounter":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Service Requests" same day as "Qualifying Encounter".

concept "High BMI Follow-up Performed":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Service Requests" performed.

concept "High BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "High BMI Follow-up Not Done With Medical Reason"
   sem-and
   "High BMI Follow-up Same Day As Qualifying Encounter"
   sem-and
   "High BMI Follow-up Performed"
).

concept "High BMI Follow-up Not Done With Reason Exists":
- type is ServiceRequest.
- value type is boolean.
- defined as exists ( "High BMI Follow-up Not Done With Reason" ).

concept "Low BMI Follow-up Not Done With Medical Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Service Requests" not done with reason "cms69-ExternalPrimitives"."Medical Reasons".

concept "Low BMI Follow-up Same Day As Qualifying Encounter":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Service Requests" same day as "Qualifying Encounter".

concept "Low BMI Follow-up Performed":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Follow-up Service Requests" performed.

concept "Low BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "Low BMI Follow-up Not Done With Medical Reason"
   sem-and
   "Low BMI Follow-up Same Day As Qualifying Encounter"
   sem-and
   "Low BMI Follow-up Performed"
).

concept "Low BMI Follow-up Not Done With Reason Exists":
- type is ServiceRequest.
- value type is boolean.
- defined as exists ( "Low BMI Follow-up Not Done With Reason" ).

concept "Weight Assessment Referral Not Done With Medical Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Weight Assessment Referrals" not done with reason "cms69-ExternalPrimitives"."Medical Reasons".

concept "Weight Assessment Referral Same Day As Qualifying Encounter":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Weight Assessment Referrals" same day as "Qualifying Encounter".

concept "Weight Assessment Referral Performed":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Weight Assessment Referrals" performed.

concept "Weight Assessment Referral Not Done With Reason":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "Weight Assessment Referral Not Done With Medical Reason"
   sem-and
   "Weight Assessment Referral Same Day As Qualifying Encounter"
   sem-and
   "Weight Assessment Referral Performed"
).

concept "Weight Assessment Referral Not Done With Reason Exists":
- type is ServiceRequest.
- value type is boolean.
- defined as exists ( "Weight Assessment Referral Not Done With Reason" ).

concept "High BMI Medication Not Done With Medical Reason":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Medications" not done with reason "cms69-ExternalPrimitives"."Medical Reasons".

concept "High BMI Medication Same Day As Qualifying Encounter":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Medications" same day as "Qualifying Encounter".

concept "High BMI Medication Performed":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Medications" performed.

concept "High BMI Medication Not Done With Reason":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "High BMI Medication Not Done With Medical Reason"
   sem-and
   "High BMI Medication Same Day As Qualifying Encounter"
   sem-and
   "High BMI Medication Performed"
).

concept "High BMI Medication Not Done With Reason Exists":
- type is MedicationRequest.
- value type is boolean.
- defined as exists ( "High BMI Medication Not Done With Reason" ).

concept "Low BMI Medication Not Done With Medical Reason":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Medications" not done with reason "cms69-ExternalPrimitives"."Medical Reasons".

concept "Low BMI Medication Same Day As Qualifying Encounter":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Medications" same day as "Qualifying Encounter".

concept "Low BMI Medication Performed":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Low BMI Medications" performed.

concept "Low BMI Medication Not Done With Reason":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "Low BMI Medication Not Done With Medical Reason"
   sem-and
   "Low BMI Medication Same Day As Qualifying Encounter"
   sem-and
   "Low BMI Medication Performed"
).

concept "Low BMI Medication Not Done With Reason Exists":
- type is MedicationRequest.
- value type is boolean.
- defined as exists ( "Low BMI Medication Not Done With Reason" ).

concept "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI":
- type is Observation.
- value type is boolean.
- defined as
(
   "High BMI Follow-up Not Done With Reason Exists"
   or
   "Low BMI Follow-up Not Done With Reason Exists"
   or
   "Weight Assessment Referral Not Done With Reason Exists"
   or
   "High BMI Medication Not Done With Reason Exists"
   or
   "Low BMI Medication Not Done With Reason Exists"
).


// --- Pregnancy during measurement period ---

concept "Pregnancy Diagnoses Active During MP":
- type is Condition.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Pregnancy Diagnoses" active during "Measurement Period".

concept "Active Pregnancy Diagnosis":
- type is Observation.
- value type is boolean.
// A boolean existence determination: is there an active pregnancy diagnosis during the MP? The
// published CMS69 measure gates the denominator exclusion on `exists`; `Is Pregnant …` consumes this
// as a boolean alongside `Verified Pregnancy Status`.
- defined as exists ( "Pregnancy Diagnoses Active During MP" ).

concept "Pregnancy Status Overlaps MP":
- type is Observation.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Pregnancy Status Observations" overlaps "Measurement Period".

concept "Pregnancy Status Verified":
- type is Observation.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Pregnancy Status Observations" verified.

concept "Pregnancy Status Documented As Pregnancy Related":
- type is Observation.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Pregnancy Status Observations" documented as "cms69-ExternalPrimitives"."Pregnancy or Other Related Diagnoses".

// #189 Slice 2 — intersect-first (3-way). The SAME pregnancy-status observation must overlap the MP AND
// be verified AND be documented-as-pregnancy-related; the pre-#189 squat emitted `exists(A) and exists(B)
// and exists(C)` (independent existence across possibly-different observations). The record `sem-and`
// (emits `intersect`) restores same-record correlation; the determination is `exists` over it.
concept "Verified Pregnancy Status Observations":
- type is Observation.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "Pregnancy Status Overlaps MP"
   sem-and
   "Pregnancy Status Verified"
   sem-and
   "Pregnancy Status Documented As Pregnancy Related"
).

concept "Verified Pregnancy Status":
- type is Observation.
- value type is boolean.
- defined as exists ( "Verified Pregnancy Status Observations" ).

concept "Is Pregnant During Measurement Period":
- type is Observation.
- value type is boolean.
- defined as
(
   "Active Pregnancy Diagnosis"
   or
   "Verified Pregnancy Status"
).


// --- Age predicate ---

concept "Age At Start Of MP At Least 18 Years":
- type is Observation.
- value type is boolean.
- definition is age at start of "Measurement Period" at least 18 years.

concept "Aged 18+ at Measurement Period Start":
- type is Observation.
- value type is boolean.
- defined as "Age At Start Of MP At Least 18 Years".
