# CMS69 Inferences Concepts

library "cms69-Inferences".

// ============ Runtime parameters ============
// "Measurement Period" is a runtime CQL parameter (issue #59) — declared in
// the inferred library because that's where its consumers live. Terminology
// libraries (which don't reference it) don't carry the declaration.

parameter "Measurement Period":
- param type is Period.


// Lifted `*Order Date` / `*Performed Date` dateTime projections REMOVED (#257 T4/STEP2).
// They bare-ref'd a resource concept as `dateTime` — a rule-B `bare-ref-value-type-mismatch`
// once the recordsource concepts collapse to single-value-type `CodeableConcept`. Their only two
// consumer shapes are now expressed at RESOURCE level: the correlated `on or before` becomes
// `<orders> on day of or after <active diagnoses>` (an order SUBSET), and the `during MP` window
// becomes `<orders> during "Measurement Period"`. See .vibe-tools/discussions/406.


// ============ Inference declarations + composing concepts ============

// --- Qualifying Encounter ---

concept "BMI Evaluation Encounter (not virtual)":
- type is Encounter.
- value type is CodeableConcept.
- defined as
(
   "cms69-ExternalPrimitives"."Encounters to Evaluate BMI"
   sem-and
   sem-not "cms69-ExternalPrimitives"."Virtual Encounters"
).

concept "BMI Evaluation Encounter (not virtual) During MP":
- type is Encounter.
- value type is CodeableConcept.
- definition is "BMI Evaluation Encounter (not virtual)" during "Measurement Period".

concept "BMI Evaluation Encounter (not virtual) Performed":
- type is Encounter.
- value type is CodeableConcept.
- definition is "BMI Evaluation Encounter (not virtual)" performed.

concept "Qualifying Encounter":
- type is Encounter.
- value type is CodeableConcept.
- defined as
(
   "BMI Evaluation Encounter (not virtual) During MP"
   sem-and
   "BMI Evaluation Encounter (not virtual) Performed"
).


// --- BMI During Measurement Period ---

concept "BMI Observation During MP":
- type is Observation.
- value type is Quantity.
- definition is "cms69-ExternalPrimitives"."BMI Observations" during "Measurement Period".

// The published CMS69 measure gates only on a BMI documented DURING the measurement
// period; the low/high/normal classification runs on the recorded value. The former
// `exceeds 0 'kg/m2'` positive-value guard was a data-quality artifact (not part of the
// measure), and `exceeds` is an inherently-boolean comparator with no record-set
// realization — so it could not be intersected as a Quantity record set. `BMI During
// Measurement Period` is therefore the during-MP BMI observations directly.
concept "BMI During Measurement Period":
- type is Observation.
- value type is Quantity.
- defined as "BMI Observation During MP".


// --- BMI clinical classifications ---

concept "BMI During MP Low":
- type is Observation.
- value type is boolean.
- definition is "BMI During Measurement Period" low.

concept "BMI During MP High":
- type is Observation.
- value type is boolean.
- definition is "BMI During Measurement Period" high.

concept "BMI During MP Normal":
- type is Observation.
- value type is boolean.
- definition is "BMI During Measurement Period" normal.

concept "Documented Low BMI":
- type is Observation.
- value type is boolean.
- defined as "BMI During MP Low".

concept "Documented High BMI":
- type is Observation.
- value type is boolean.
- defined as "BMI During MP High".

concept "Normal BMI Range":
- type is Observation.
- value type is boolean.
- defined as "BMI During MP Normal".


// --- Has Normal BMI ---

concept "Without Documented Abnormal BMI":
- type is Observation.
- value type is boolean.
- definition is without documented ("Documented High BMI" or "Documented Low BMI").

concept "Has Normal BMI":
- type is Observation.
- value type is boolean.
- defined as
(
   "Normal BMI Range"
   and
   "Without Documented Abnormal BMI"
).


// --- Co-existing diagnoses ---

concept "Overweight or Obese Diagnoses Active":
- type is Condition.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Overweight or Obese Diagnoses" active.

concept "Underweight Diagnoses Active":
- type is Condition.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Underweight Diagnoses" active.


// --- High BMI Interventions Ordered ---

concept "High BMI Follow-up Justified by Overweight Diagnosis":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Service Requests" justified by "cms69-ExternalPrimitives"."Overweight or Obese Diagnoses".

concept "High BMI Follow-up Preceded by Overweight Diagnosis":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Service Requests" on day of or after "Overweight or Obese Diagnoses Active".

concept "High BMI Follow-up Order":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "High BMI Follow-up Justified by Overweight Diagnosis"
   sem-or
   "High BMI Follow-up Preceded by Overweight Diagnosis"
).

concept "High BMI Follow-up Order Exists":
- type is ServiceRequest.
- value type is boolean.
- defined as exists ( "High BMI Follow-up Order" ).

concept "Weight Assessment Referral Justified by Overweight Diagnosis":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Weight Assessment Referrals" justified by "cms69-ExternalPrimitives"."Overweight or Obese Diagnoses".

concept "Weight Assessment Referral Preceded by Overweight Diagnosis":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."Weight Assessment Referrals" on day of or after "Overweight or Obese Diagnoses Active".

concept "High BMI Weight Assessment Referral":
- type is ServiceRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "Weight Assessment Referral Justified by Overweight Diagnosis"
   sem-or
   "Weight Assessment Referral Preceded by Overweight Diagnosis"
).

concept "High BMI Weight Assessment Referral Exists":
- type is ServiceRequest.
- value type is boolean.
- defined as exists ( "High BMI Weight Assessment Referral" ).

concept "High BMI Medication Justified by Overweight Diagnosis":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Medications" justified by "cms69-ExternalPrimitives"."Overweight or Obese Diagnoses".

concept "High BMI Medication Preceded by Overweight Diagnosis":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Medications" on day of or after "Overweight or Obese Diagnoses Active".

concept "High BMI Medication Order":
- type is MedicationRequest.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "High BMI Medication Justified by Overweight Diagnosis"
   sem-or
   "High BMI Medication Preceded by Overweight Diagnosis"
).

concept "High BMI Medication Order Exists":
- type is MedicationRequest.
- value type is boolean.
- defined as exists ( "High BMI Medication Order" ).

concept "High BMI Interventions Ordered":
- type is Observation.
- value type is boolean.
- defined as
(
   "High BMI Follow-up Order Exists"
   or
   "High BMI Weight Assessment Referral Exists"
   or
   "High BMI Medication Order Exists"
).


// --- High BMI Interventions Performed ---

concept "High BMI Procedure Justified by Overweight Diagnosis":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Procedures" justified by "cms69-ExternalPrimitives"."Overweight or Obese Diagnoses".

concept "High BMI Procedure Preceded by Overweight Diagnosis":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- definition is "cms69-ExternalPrimitives"."High BMI Follow-up Procedures" on day of or after "Overweight or Obese Diagnoses Active".

concept "High BMI Procedure Performed":
- type is Procedure.
- value type is CodeableConcept.
- shape is RecordSet.
- defined as
(
   "High BMI Procedure Justified by Overweight Diagnosis"
   sem-or
   "High BMI Procedure Preceded by Overweight Diagnosis"
).

concept "High BMI Procedure Performed Exists":
- type is Procedure.
- value type is boolean.
- defined as exists ( "High BMI Procedure Performed" ).


// --- High BMI And Follow Up Provided ---

// `Documented High BMI` is already Measurement-Period-scoped (via `BMI During Measurement
// Period`), so the former `... During MP` wrapper was a redundant `during` over a derived
// boolean — a rule-B `boolean-at-refinement-position`. Removed; the composition uses the
// already-MP-scoped boolean directly (#257 T4/STEP2). The measure's outer BMI↔intervention
// during-MP join is a separate pre-existing fidelity gap (#267 E3).

concept "High BMI And Follow Up Provided":
- type is Observation.
- value type is boolean.
- defined as
(
   "Documented High BMI"
   and
   (
      "High BMI Interventions Ordered"
      or
      "High BMI Procedure Performed Exists"
   )
).


