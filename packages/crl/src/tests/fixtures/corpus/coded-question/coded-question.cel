# Legacy classifier data: bare option codes resolve through the named answer vocabulary.
// New language authoring is demonstrated by the Bleph acceptance fixture.
library "CodedQuestionCases".
covers "Coded Question Reference".

fact "Pat":
- name is "Pat".
- birth date is "1970-01-01".
- defined by "Patient".

fact "Requested":
- value is true.
- date is "2026-01-02".
- defined by "Service Requested".

// ⭐ A BARE option code — no system.
fact "Qualifying Symptom":
- value is "functional-limitation".
- date is "2026-01-02".
- defined by "Coded Question Reference"."Documented Symptom".

// ⭐⭐ ONE ANSWER DENIES. Without this option the criterion would stay UNKNOWN and the tree would PAUSE; the
// user would have to answer every symptom NO to reach a denial.
fact "No Listed Symptom":
- value is "none-of-listed".
- date is "2026-01-02".
- defined by "Coded Question Reference"."Documented Symptom".

// ⭐ A LATER answer overrides an earlier one — `most recent this` publishes the newest record.
fact "No Listed Symptom Later":
- value is "none-of-listed".
- date is "2026-03-01".
- defined by "Coded Question Reference"."Documented Symptom".

case "a qualifying answer -> certify":
- subject is "Pat".
- fact is "Requested".
- fact is "Qualifying Symptom".
- result is "Coverage Determination" is "certify.Met".

case "none of the listed -> not certify, in ONE answer":
- subject is "Pat".
- fact is "Requested".
- fact is "No Listed Symptom".
- result is "Coverage Determination" is "not-certify.Unmet".

case "a later none answer overrides an earlier qualifying one -> not certify":
- subject is "Pat".
- fact is "Requested".
- fact is "Qualifying Symptom".
- fact is "No Listed Symptom Later".
- result is "Coverage Determination" is "not-certify.Unmet".

case "missing answer pauses":
- subject is "Pat".
- fact is "Requested".
- result is "Coverage Determination" is pause.
