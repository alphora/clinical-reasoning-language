# Seam caseload — exercises BOTH derive-local domain cells (included=bare, sibling=disambiguated).
library "Seam Coverage Cases".
covers "Seam Root".

// No authored `code is` on either clinical fact — both codes DERIVE from the concept.

fact "Pat":
- name is "Pat".
- birth date is "1970-01-01".
- defined by "Patient".

fact "Included Present":
- date is "2026-01-01".
- defined by "Seam Included"."Included Finding".

fact "Sibling Present":
- date is "2026-01-01".
- defined by "Seam Sibling"."Sibling Finding".

case "Included finding present":
- subject is "Pat".
- fact is "Included Present".
- result is "Seam Coverage" is "certify.Approve".

case "Sibling finding present":
- subject is "Pat".
- fact is "Sibling Present".
- result is "Seam Coverage" is "certify.Approve".
