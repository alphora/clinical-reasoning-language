# criterion-xor-reverse: criterion declared BEFORE the same-named concept; XOR must fire regardless of order (names the prior kind = criterion).
library "Root".

criterion "Eligible":
- when ( "Age Qualifies" ).

concept "Age Qualifies":
- type is Observation.
- value type is boolean.
- code is `age`.

concept "Eligible":
- type is Observation.
- value type is boolean.
- code is `elig`.
