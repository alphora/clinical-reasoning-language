{
  "name": "@smile-digital-health/crl",
  "version": "4.112.0",
  "description": "Clinical Reasoning Language (CRL) parser and validator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crl-emit": "dist/cli/run-emitter.js",
    "crl-validate": "dist/cli/run-validator.js",
    "crl-lex": "dist/cli/run-lexer.js",
    "crl-parse": "dist/cli/run-parser.js",
    "crl-ast": "dist/cli/run-ast.js",
    "crl-template-match": "dist/cli/run-template-match.js",
    "crl-canonicalize-source": "dist/cli/run-canonicalize-source.js",
    "crl-validate-provenance": "dist/cli/run-validate-provenance.js",
    "crl-generate-provenance": "dist/cli/run-generate-provenance.js",
    "crl-normalize-provenance": "dist/cli/run-normalize-provenance.js",
    "crl-check-fhir-ids": "dist/cli/run-check-fhir-ids.js",
    "crl-emit-results": "dist/cli/run-emit-results.js",
    "crl-mcp": "dist/cli/run-mcp-server.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./language-services": {
      "types": "./dist/language-services/index.d.ts",
      "import": "./dist/language-services/index.js",
      "require": "./dist/language-services/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "import": "./dist/provenance/index.js",
      "require": "./dist/provenance/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.json",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.cql",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "vitest run --root ../.. --project crl --no-file-parallelism",
    "pretest:mcp": "npm run build",
    "test:mcp": "node src/cli/tests/run-mcp-server.test.mjs",
    "prebuild": "rimraf dist && shx mkdir -p dist && npm run generate && cpx \"src/grammar/generated/types/*.json\" dist/grammar/generated/types/ && node scripts/checkGrammarJsonFiles.js",
    "build": "tsc && node scripts/copy-catalog.mjs",
    "clean": "rimraf dist",
    "watch": "onchange -i \"src/**/*.ts\" -- npm run build",
    "start": "npm run build && node dist/index.js",
    "compile": "tsc --noEmit",
    "prepack": "npm run build",
    "extract-types": "node scripts/extractActivityTypes.js && node scripts/extractConceptTypes.js && node scripts/extractConceptValueTypes.js && node scripts/extractConceptShapes.js && node scripts/extractParameterTypes.js && node scripts/generateMetadataRegistry.js",
    "move-generated-files": "node scripts/moveGeneratedFiles.js",
    "generate": "antlr4ts -Xforce-atn src/grammar/CRLLexer.g4 && antlr4ts -Xforce-atn -visitor src/grammar/CRLParser.g4 && antlr4ts -Xforce-atn src/grammar/CELLexer.g4 && antlr4ts -Xforce-atn -visitor src/grammar/CELParser.g4 && npm run move-generated-files && npm run extract-types",
    "cli:lexer": "ts-node src/cli/run-lexer.ts",
    "cli:lexer:pretty": "ts-node src/cli/run-lexer.ts --pretty",
    "cli:parser": "ts-node src/cli/run-parser.ts",
    "cli:parser:pretty": "ts-node src/cli/run-parser.ts --pretty",
    "cli:ast": "ts-node src/cli/run-ast.ts",
    "cli:ast:pretty": "ts-node src/cli/run-ast.ts --pretty",
    "cli:validator": "ts-node src/cli/run-validator.ts",
    "cli:validator:pretty": "ts-node src/cli/run-validator.ts --pretty",
    "cli:template-match": "ts-node src/cli/run-template-match.ts",
    "cli:emitter": "ts-node src/cli/run-emitter.ts",
    "cli:mcp": "ts-node src/cli/run-mcp-server.ts",
    "cli:transformer:fsh-to-crl": "ts-node src/cli/run-transformer-fsh-to-crl.ts",
    "test:watch": "vitest --root ../.. --project crl --no-file-parallelism",
    "test:coverage": "vitest run --root ../.. --project crl --no-file-parallelism --coverage",
    "test:regression": "vitest run --root ../.. --project crl --no-file-parallelism --reporter=verbose",
    "prerelease": "node scripts/prereleaseGithub.js",
    "util:clonefsh": "npx ts-node scripts/clone-fsh-repo.ts",
    "git:unmerged": "ts-node scripts/unmerged-branches.ts"
  },
  "keywords": [
    "clinical",
    "practice",
    "guideline",
    "language",
    "parser",
    "validator"
  ],
  "author": "CQIS",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "antlr4ts": "^0.5.0-alpha.4",
    "cpx": "^1.2.1",
    "fsh-sushi": "^3.15.0",
    "prompts": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "onchange": "^7.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
