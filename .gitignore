# Dependency directories
node_modules/

# Build outputs
dist/
build/
lib/
coverage/
src/grammar/generated/
tsconfig.tsbuildinfo
*.tgz

# Debug & log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/editor settings (keep settings.json only)
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

.vscode/*
!.vscode/settings.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test outputs
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Vibe Tools — extension-managed assets (protocols/, prompts/) +
# Claude-maintained local workflow artifacts (discussions/, retros/).
# Safe to delete to reset the extension; you will lose any local
# consultation transcripts and retros. Promote durable decisions to
# your project's normal docs location before cleanup.
.vibe-tools/

# Agent-managed root files (provisioned per-machine by the CRL + vibe-tools
# extensions; they hold local paths / generated blocks, not project source).
/CLAUDE.md
/.mcp.json


issues/

# Regression test output artifacts: regenerated on every test run; only
# the *-expected.* fixtures are committed baselines.
src/tests/regression/testdata/*-actual.*

# Feature working artifacts: source corpora dropped in for analysis and
# derived data (decoded ELM forests, etc.). Source folders often contain
# their own .git checkouts and are huge; derived data is regenerable.
# Committed artifacts (README, scripts, results) live alongside but stay tracked.
features/*/sources/
features/*/data/
