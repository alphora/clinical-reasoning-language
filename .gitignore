# Dependency directories
node_modules/
# ...except test fixture node_modules — these are committed fake packages
# exercised by resolver tests; they are not real npm dependencies.
!packages/crl/src/imports/tests/fixtures/**/node_modules/
!packages/crl/src/imports/tests/fixtures/**/node_modules/**

# Build outputs
dist/
build/
lib/
coverage/
packages/crl/src/grammar/generated/
packages/crl/src/meta/generated/
tsconfig.tsbuildinfo
*.tgz

# Debug & log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE/editor settings (keep settings.json only)
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

.vscode/*
!.vscode/settings.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Test outputs
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# .claude/ holds per-machine provisioned files (settings.local.json, etc.) — ignored —
# EXCEPT skills/ and agents/, which are versioned CRL-domain project tooling
# (co-versioned with the grammar; see .claude/skills/encode-policy-to-crl, .claude/agents).
.claude/*
!.claude/skills/
!.claude/agents/
.cursor/

issues/

# Regression test output artifacts: regenerated on every test run; only
# the *-expected.* fixtures are committed baselines.
packages/crl/src/tests/regression/testdata/*-actual.*

# Feature working artifacts: local analysis corpora, derived data, and
# modeling scratch work. Kept local, not tracked in version control.
features/
# step-3 golden-oracle build output (regenerable)
packages/*/test/oracle/.gen/

.vibe-tools/
/.mcp.json
.vibe-corpus.json
.vibe-mail.json
.claude/agents/vibe-reviewer-*.md
.claude/agents/vibe-panel-*.md
.claude/settings.local.json

# Release checksums — generated per release, attached as an asset, never committed.
SHA256SUMS

# vibe-tools:begin
/.codex/config.toml
/.codex/agents/vibe-reviewer-*.toml
# vibe-tools:end

# Per-machine lifecycle wiring; shared implementation remains tracked.
/.codex/hooks.json
/.codex/lifecycle.local.json
/.codex/**/__pycache__/
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/refactor-state.sh
