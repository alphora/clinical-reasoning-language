/*
  This decision is generated from the IMMZDTImmunizationStrategy instance.
  It contains one top-level action "Check Immunizations" whose nested actions 
  reference further plan definitions via definitionCanonical.
*/
decision "IMMZDTImmunizationStrategy":
    when "Check Immunizations" then:
        when "Measles Dose 0" then use "IMMZD2DTMeaslesDose0".
        when "Measles Routine Immunization" then use "OTIMMZD2DTMeasles".
        when "Measles Supplementary Dose" then use "IMMZD2DTMeaslesSupplementary".
        when "Measles Contraindications" then use "IMMZD5DTMeaslesCI".
    done
done

// ========================================================
// Decisions Derived via DefinitionCanonical References (Simple Plans)
// ========================================================

/*
  Decision for IMMZD2DTMeaslesDose0.fsh.
  Contains the leaf action "Perform Dose 0 Administration".
*/
decision "IMMZD2DTMeaslesDose0":
    when "Perform Dose 0 Administration" then do "IMMZD2DTMeaslesDose0_activity".
done
/* 
   ValueMarkdown: "Ensure proper dosage based on patient weight." 
*/
activity "IMMZD2DTMeaslesDose0_activity" perform CPGCommunicationRequest.


/*
  Decision for IMMZD2DTMeaslesSupplementary.fsh.
  Contains the leaf action "Administer Supplementary Dose".
*/
decision "IMMZD2DTMeaslesSupplementary":
    when "Administer Supplementary Dose" then do "IMMZD2DTMeaslesSupplementary_activity".
done
/* 
   ValueMarkdown: "Follow up with serologic testing if needed." 
*/
activity "IMMZD2DTMeaslesSupplementary_activity" perform CPGCommunicationRequest.


/*
  Decision for IMMZD5DTMeaslesCI.fsh.
  Contains the leaf action "Evaluate Contraindications".
*/
decision "IMMZD5DTMeaslesCI":
    when "Evaluate Contraindications" then do "IMMZD5DTMeaslesCI_activity".
done
/* 
   ValueMarkdown: "Consider known allergic reactions and medical history." 
*/
activity "IMMZD5DTMeaslesCI_activity" perform CPGCommunicationRequest.


// ========================================================
// Updated Decision for OTIMMZD2DTMeasles (Complex Routine Immunization)
// Derived from the routine immunization plan definition (formerly IMMZD2DTMeaslesOT.fsh)
// but now augmented with nested conditions and actions.
// ========================================================
/*
  Decision "OTIMMZD2DTMeasles" now reflects a more complex nested structure.
  The top-level action is "Administer Routine Immunization" with a valueMarkdown of 
  "Standard dose as per immunization schedule." This action now branches into nested 
  sub-actions for additional checks.
*/
decision "OTIMMZD2DTMeasles":
    when "Administer Routine Immunization" then:
         /*
           Nested branch: Check if the patient has no prior measles immunization.
           (Condition derived from the nested action's condition expression.)
         */
         when "Check Prior Vaccination History" then do "OTIMMZD2DTMeasles_CheckHistory_activity".
         /*
           Nested branch: Assess if the patient is eligible for routine measles vaccine.
         */
         when "Assess Patient Eligibility" then do "OTIMMZD2DTMeasles_AssessEligibility_activity".
    done
done

/* 
   Comments for the nested actions in OTIMMZD2DTMeasles:
   - "Administer Routine Immunization": ValueMarkdown "Standard dose as per immunization schedule." 
     is used as the parent rationale.
   - For the nested actions, we assume descriptive rationale as follows.
*/
activity "OTIMMZD2DTMeasles_CheckHistory_activity" perform CPGCommunicationRequest. 
// Check if the patient has no prior measles immunization.

activity "OTIMMZD2DTMeasles_AssessEligibility_activity" perform CPGCommunicationRequest. 
// Assess if the patient is eligible for the routine measles vaccine.


// ========================================================
// Decision for IMMZD2DTMeaslesLT.fsh (Complex Logic)
// ========================================================
/*
  This decision is generated from the IMMZD2DTMeaslesLT instance.
  It encodes multiple levels of nested actions and conditions.
*/
decision "IMMZD2DTMeaslesLT":
    when "Immunize patient for Measles" then:
        /*
          Top-level condition: "Measles Routine Immunization Schedule Incomplete"
          Under this branch, there are separate flows for primary series vaccination.
        */
        when "Provide primary series measles vaccination (MCV1)" then:
            /*
              Branch for MCV1:
              Condition "No Primary Series Doses Administered" applies with three nested actions.
            */
            when "Client Age Less Than 12 Months" then do "IMMZD2DTMeaslesLT_MCV1_ClientAgeLessThan12_activity".
            when "Last Live Vaccine Administered Within 4 Weeks" then do "IMMZD2DTMeaslesLT_MCV1_LastLiveWithin4Weeks_activity".
            when "Provide Measles Vaccine" then use "IMMZD2DTMeaslesMR".
        done
        when "Provide primary series measles vaccination (MCV2)" then:
            /*
              Branch for MCV2:
              Condition "One Primary Series Dose Administered" applies with three nested actions.
            */
            when "Client Age Less Than 15 Months" then do "IMMZD2DTMeaslesLT_MCV2_ClientAgeLessThan15_activity".
            when "Last Live Vaccine Administered Within 4 Weeks" then do "IMMZD2DTMeaslesLT_MCV2_LastLiveWithin4Weeks_activity".
            when "Provide Measles Vaccine" then use "IMMZD2DTMeaslesMR".
        done
        when "Measles primary series is complete." then do "IMMZD2DTMeaslesLT_PrimarySeriesComplete_activity".
    done
done

/*
  Decision for IMMZD2DTMeaslesMR.
  This plan definition is referenced by IMMZD2DTMeaslesLT for providing the measles vaccine.
  (If detailed logic exists in its FSH file, it would be processed recursively;
   here we provide a placeholder decision.)
*/
decision "IMMZD2DTMeaslesMR":
    when "Administer Measles Vaccine" then do "IMMZD2DTMeaslesMR_activity".
done
/* 
   Using the description as a comment:
   "Perform measles vaccine administration as per protocol."
*/
activity "IMMZD2DTMeaslesMR_activity" perform MedicationRequest.


// ========================================================
// Activities for Leaf Actions in IMMZD2DTMeaslesLT
// ========================================================
/* 
   Activity for "Client Age Less Than 12 Months" (MCV1 branch).
   Description: "Should not vaccinate client as client's age is less than 12 months. Check for any vaccines due, and inform the caregiver of when to come back for MCV1."
*/
activity "IMMZD2DTMeaslesLT_MCV1_ClientAgeLessThan12_activity" perform CPGCommunicationRequest.

/* 
   Activity for "Last Live Vaccine Administered Within 4 Weeks" (MCV1 branch).
   Description: "Should not vaccinate client for MCV1 as live vaccine was administered in the last 4 weeks. Check for any vaccines due and inform the caregiver of when to come back for MCV1."
*/
activity "IMMZD2DTMeaslesLT_MCV1_LastLiveWithin4Weeks_activity" perform CPGCommunicationRequest.

/* 
   Activity for "Client Age Less Than 15 Months" (MCV2 branch).
   Description: "Should not vaccinate client for MCV2 as client's age is less than 15 months. Check for any vaccines due, and inform the caregiver of when to come back for MCV2."
*/
activity "IMMZD2DTMeaslesLT_MCV2_ClientAgeLessThan15_activity" perform CPGCommunicationRequest.

/* 
   Activity for "Last Live Vaccine Administered Within 4 Weeks" (MCV2 branch).
   Description: "Should not vaccinate client for MCV2 as live vaccine was administered in the last 4 weeks. Check for any vaccines due, and inform the caregiver of when to come back for MCV2."
*/
activity "IMMZD2DTMeaslesLT_MCV2_LastLiveWithin4Weeks_activity" perform CPGCommunicationRequest.

/* 
   Activity for "Measles primary series is complete." 
   ValueMarkdown (preferred): 
   "An additional dose of MCV should be administered to HIV-infected children receiving HAART following immune reconstitution. If CD4+ T lymphocyte counts are monitored, an additional dose of MCV should be administered when immune reconstitution has been achieved, e.g. when the CD4+ T lymphocyte count reaches 20–25%. Where CD4+ T lymphocyte monitoring is not available, children should receive an additional dose of MCV 6–12 months after initiation of HAART."
*/
activity "IMMZD2DTMeaslesLT_PrimarySeriesComplete_activity" perform CPGCommunicationRequest.

  
// ========================================================
// Concept Declarations & Terminology Statements
// Terminal when-clause conditions are represented as concepts (type Observation, valuetype boolean)
// and receive only a 'coded by' clause. The 'coded by' references a terminology statement whose system
// is the top-level decision ("IMMZDTImmunizationStrategy") and whose code is the concept name with spaces removed.
// ========================================================

concept "Check Immunizations":
    has type Observation.
    has valuetype boolean.
    coded by "IMMZDTImmunizationStrategy_CheckImmunizations_Term".
done
terminology "IMMZDTImmunizationStrategy_CheckImmunizations_Term" system "IMMZDTImmunizationStrategy" code "CheckImmunizations".

