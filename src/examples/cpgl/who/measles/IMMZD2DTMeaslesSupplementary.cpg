decision "IMMZD2DTMeaslesSupplementary":
    when "Measles Routine Immunization Schedule Complete" then:
        when "Candidate For Supplementary Dose" then do "Administer Supplementary Dose".
    done
done

concept "Measles Routine Immunization Schedule Complete":
    has type Observation.
    has valuetype boolean.
    inferred by ("Candidate For Supplementary Dose").
done

concept "Candidate For Supplementary Dose":
    has type Observation.
    has valuetype boolean.
    coded by "Candidate For Supplementary Dose".
done

terminology "Candidate For Supplementary Dose" system "IMMZD2DTMeaslesSupplementary" code "candidate-for-supplementary-dose".

// Administer a supplementary dose of measles vaccine when routine schedule has been completed and based on context.
activity "Administer Supplementary Dose" perform CommunicationRequest.
