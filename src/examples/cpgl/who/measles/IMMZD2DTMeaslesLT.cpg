decision "IMMZD2DTMeaslesLT":
    when "Measles Routine Immunization Schedule Incomplete" then:
        when "No Primary Series Doses Administered" then:
            when "Client Age Less Than 12 Months" then do "Wait Until 12 Months".
            when "Last Live Vaccine Administered Within 4 Weeks" then do "Wait Until After 4 Weeks".
            when "Client Is Due For MCV1" then use "IMMZD2DTMeaslesMR".
        done
        when "One Primary Series Dose Administered" then:
            when "Client Age Less Than 15 Months" then do "Wait Until 15 Months".
            when "Last Live Vaccine Administered Within 4 Weeks" then do "Wait Until After 4 Weeks".
            when "Client Is Due For MCV2" then use "IMMZD2DTMeaslesMR".
        done
        when "Two Primary Series Doses Administered" then do "Measles Primary Series Complete".
    done
done

concept "Measles Routine Immunization Schedule Incomplete":
    has type Observation.
    has valuetype boolean.
    inferred by ("No Primary Series Doses Administered" and "One Primary Series Dose Administered" and "Two Primary Series Doses Administered").
done

concept "No Primary Series Doses Administered":
    has type Observation.
    has valuetype boolean.
    inferred by ("Client Age Less Than 12 Months" and "Last Live Vaccine Administered Within 4 Weeks" and "Client Is Due For MCV1").
done

concept "One Primary Series Dose Administered":
    has type Observation.
    has valuetype boolean.
    inferred by ("Client Age Less Than 15 Months" and "Last Live Vaccine Administered Within 4 Weeks" and "Client Is Due For MCV2").
done

concept "Two Primary Series Doses Administered":
    has type Observation.
    has valuetype boolean.
    coded by "Two Primary Series Doses Administered".
done

terminology "Two Primary Series Doses Administered" system "IMMZD2DTMeaslesLT" code "two-primary-series-doses-administered".

concept "Client Age Less Than 12 Months":
    has type Observation.
    has valuetype boolean.
    coded by "Client Age Less Than 12 Months".
done

terminology "Client Age Less Than 12 Months" system "IMMZD2DTMeaslesLT" code "client-age-less-than-12-months".

concept "Last Live Vaccine Administered Within 4 Weeks":
    has type Observation.
    has valuetype boolean.
    coded by "Last Live Vaccine Administered Within 4 Weeks".
done

terminology "Last Live Vaccine Administered Within 4 Weeks" system "IMMZD2DTMeaslesLT" code "last-live-vaccine-administered-within-4-weeks".

concept "Client Is Due For MCV1":
    has type Observation.
    has valuetype boolean.
    coded by "Client Is Due For MCV1".
done

terminology "Client Is Due For MCV1" system "IMMZD2DTMeaslesLT" code "client-is-due-for-mcv1".

concept "Client Age Less Than 15 Months":
    has type Observation.
    has valuetype boolean.
    coded by "Client Age Less Than 15 Months".
done

terminology "Client Age Less Than 15 Months" system "IMMZD2DTMeaslesLT" code "client-age-less-than-15-months".

concept "Client Is Due For MCV2":
    has type Observation.
    has valuetype boolean.
    coded by "Client Is Due For MCV2".
done

terminology "Client Is Due For MCV2" system "IMMZD2DTMeaslesLT" code "client-is-due-for-mcv2".

// Should not vaccinate client as client's age is less than 12 months.
activity "Wait Until 12 Months" perform CommunicationRequest.

// Should not vaccinate client as client's age is less than 15 months.
activity "Wait Until 15 Months" perform CommunicationRequest.

// Should not vaccinate due to recent live vaccine.
activity "Wait Until After 4 Weeks" perform CommunicationRequest.

// Measles primary series is complete.
activity "Measles Primary Series Complete" perform CommunicationRequest.
