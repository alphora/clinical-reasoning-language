  {
    "line": 123,
    "column": 9,
    "type": "QUOTED_STRING",
    "text": "\"Measles primary series is complete.\""
  },
  {
    "line": 124,
    "column": 4,
    "type": "PERFORM",
    "text": "perform"
  },
  {
    "line": 124,
