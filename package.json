{
  "name": "clinical-reasoning-language",
  "private": true,
  "version": "6.0.0",
  "description": "Monorepo for the Clinical Reasoning Language (CRL): language core, VS Code extension, and the Coral editor.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/crl",
    "packages/crl-vscode"
  ],
  "scripts": {
    "build": "npm run build -w @smile-digital-health/crl",
    "test": "npm test -w @smile-digital-health/crl && npm test -w crl-language-support",
    "test:mcp": "npm run test:mcp -w @smile-digital-health/crl",
    "test:ext": "npm test -w crl-language-support",
    "pretest:native:bleph": "npm run build",
    "test:native:bleph": "node packages/crl/scripts/native-acceptance/run.cjs",
    "pretest:native:bleph-session": "npm run build",
    "test:native:bleph-session": "node packages/crl/scripts/native-acceptance/session.cjs",
    "pretest:native:checks": "npm run build",
    "test:native:checks": "node --test packages/crl/scripts/native-acceptance/check.test.cjs packages/crl/scripts/native-acceptance/batch.test.cjs packages/crl/scripts/native-acceptance/session.test.cjs packages/crl/scripts/native-acceptance/bmi-session.test.cjs",
    "test:vitest": "vitest run --no-file-parallelism",
    "package:extension": "npm run package -w crl-language-support",
    "seed:questionnaire": "node packages/crl-vscode/scripts/seed-questionnaire-fixture.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/node": "20.17.31"
  }
}
