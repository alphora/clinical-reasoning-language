{
  "name": "@cqis/cpgl",
  "version": "0.1.0",
  "description": "Clinical Practice Guideline Language (CPGL) parser and validator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest src/lexer/tests/index.test.ts src/ast/tests/index.test.ts src/validator/tests/index.test.ts",
    "build": "rimraf dist && mkdir dist && tsc",
    "clean": "rimraf dist",
    "watch": "onchange -i \"src/**/*.ts\" -- npm run build",
    "start": "npm run build && node dist/index.js",
    "compile": "tsc --noEmit",
    "prepare": "npm run build",
    "generate": "antlr4ts -Xforce-atn -o src/grammar/generated src/grammar/CPGLLexer.g4 && antlr4ts -Xforce-atn -o src/grammar/generated src/grammar/CPGLParser.g4",
    "cli:lexer": "ts-node src/cli/run-lexer.ts",
    "cli:lexer:raw": "ts-node src/cli/run-lexer.ts --raw",
    "cli:parser": "ts-node src/cli/run-parser.ts",
    "cli:parser:raw": "ts-node src/cli/run-parser.ts --raw",
    "cli:ast": "ts-node src/cli/run-ast.ts",
    "cli:ast:raw": "ts-node src/cli/run-ast.ts --raw",
    "cli:validator": "ts-node src/cli/run-validator.ts",
    "cli:validator:raw": "ts-node src/cli/run-validator.ts --raw",
    "prebuild": "npm run clean",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "clinical",
    "practice",
    "guideline",
    "language",
    "parser",
    "validator"
  ],
  "author": "CQIS",
  "license": "MIT",
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "onchange": "^7.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
