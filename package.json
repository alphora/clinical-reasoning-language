{
  "name": "clinical-practice-guideline-language",
  "version": "0.1.0",
  "description": "A lexer and parser for the Clinical Practice Guideline Language (CPGL)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint . --ext .ts --yes",
    "lint:fix": "eslint . --ext .ts --fix --yes",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "build": "tsc",
    "clean": "rimraf dist",
    "watch": "onchange -i \"src/**/*.ts\" -- npm run build",
    "start": "npm run build && node dist/index.js",
    "compile": "tsc --noEmit",
    "prepare": "npm run build",
    "example": "npm run build && node dist/examples/basicUsage.js",
    "example:basic": "npm run build && node dist/examples/basicUsage.js",
    "example:debug": "npm run build && node dist/examples/debugLexer.js",
    "example:full": "npm run build && node dist/examples/fullExample.js",
    "generate": "antlr4ts -visitor -Xforce-atn -o src/grammar/generated src/grammar/CPGLLexer.g4 && antlr4ts -visitor -Xforce-atn -o src/grammar/generated src/grammar/CPGLParser.g4"
  },
  "keywords": [
    "clinical",
    "guideline",
    "lexer",
    "parser",
    "CPGL"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "c8": "^10.1.2",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "onchange": "^7.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "sinon": "^18.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "tabWidth": 2,
    "arrowParens": "avoid"
  }
}
