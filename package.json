{
  "name": "@smiledigitalhealth/crl",
  "version": "0.6.1",
  "description": "Clinical Practice Guideline Language (CRL) parser and validator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.json",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.ts' --quiet",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest src/lexer/tests/index.test.ts src/parser/tests/index.test.ts src/ast/tests/index.test.ts src/validator/tests/index.test.ts src/tests/index.test.ts",
    "build": "rimraf dist && shx mkdir -p dist && tsc",
    "postbuild": "node scripts/checkGrammarJsonFiles.js && npm run postbuild:types",
    "postbuild:types": "cpx \"src/grammar/generated/types/*.json\" dist/grammar/generated/types/",
    "clean": "rimraf dist",
    "watch": "onchange -i \"src/**/*.ts\" -- npm run build",
    "start": "npm run build && node dist/index.js",
    "compile": "tsc --noEmit",
    "prepare": "npm run build",
    "extract-activity-types": "node scripts/extractActivityTypes.js",
    "extract-concept-types": "node scripts/extractConceptTypes.js",
    "extract-concept-value-types": "node scripts/extractConceptValueTypes.js",
    "generate": "npm run extract-activity-types && npm run extract-concept-types && npm run extract-concept-value-types && antlr4ts -Xforce-atn -o src/grammar/generated/antlr src/grammar/CRLLexer.g4 && antlr4ts -Xforce-atn -visitor -o src/grammar/generated/antlr src/grammar/CRLParser.g4",
    "cli:lexer": "ts-node src/cli/run-lexer.ts",
    "cli:lexer:pretty": "ts-node src/cli/run-lexer.ts --pretty",
    "cli:parser": "ts-node src/cli/run-parser.ts",
    "cli:parser:pretty": "ts-node src/cli/run-parser.ts --pretty",
    "cli:ast": "ts-node src/cli/run-ast.ts",
    "cli:ast:pretty": "ts-node src/cli/run-ast.ts --pretty",
    "cli:validator": "ts-node src/cli/run-validator.ts",
    "cli:validator:pretty": "ts-node src/cli/run-validator.ts --pretty",
    "cli:transformer:fsh-to-crl": "ts-node src/cli/run-transformer-fsh-to-crl.ts",
    "prebuild": "npm run clean",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:regression": "jest src/tests/index.test.ts --verbose --no-cache --colors --forceExit --detectOpenHandles --watchAll=false",
    "prepublish:github": "node scripts/prepublishGithub.js",
    "util:clonefsh": "npx ts-node scripts/clone-fsh-repo.ts",
    "git:unmerged": "ts-node scripts/unmerged-branches.ts"
  },
  "keywords": [
    "clinical",
    "practice",
    "guideline",
    "language",
    "parser",
    "validator"
  ],
  "author": "CQIS",
  "license": "MIT",
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "cpx": "^1.2.1",
    "fsh-sushi": "^3.15.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "onchange": "^7.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "shx": "^0.4.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
