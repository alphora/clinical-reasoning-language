- logic is "Has Underweight" on or before "Weight Assessment Referral Date".

concept "Weight Assessment Referral Date During MP":
- type is Observation.
- valuetype is boolean.
- logic is "Weight Assessment Referral Date" during "Measurement Period".

concept "Low BMI Weight Assessment Referral":
