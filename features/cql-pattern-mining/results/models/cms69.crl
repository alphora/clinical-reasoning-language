# CMS69 BMI Screening and Follow-Up — v0.6 grammar

// Migrated to CRL v0.6: `concept` is the only declaration kind; `logic is` body for narrative predicates;
// concept `inferred from` body is bare ref or sem-or/sem-and/sem-not composition.
// All multi-clause concepts now compose named inferences via sem-* operators.


// ============ Terminologies (valuesets) ============
// Real valuesets from the source CMS69 CQL library with VSAC URLs.

terminology "Encounter to Evaluate BMI":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.600.1.1751`.

terminology "Follow Up for Above Normal BMI":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.600.1.1525`.

terminology "Follow Up for Below Normal BMI":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.600.1.1528`.

terminology "Medical Reason":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1007`.

terminology "Medications for Above Normal BMI":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1561`.

terminology "Medications for Below Normal BMI":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1562`.

terminology "Overweight or Obese":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1047.502`.

terminology "Patient Declined":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1582`.

terminology "Pregnancy or Other Related Diagnoses":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.600.1.1623`.

terminology "Referrals Where Weight Assessment May Occur":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.600.1.1527`.

terminology "Underweight":
- valueset is `http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.526.3.1563`.

// Stub valuesets — referenced by the CRL but not in source CQL.
// Some are codes-wrapped-as-1-element-valuesets (CRL convention since
// `coded from` requires a valueset); others are author-added composites
// the source CQL hadn't formalized. Empty URL = placeholder until proper
// VSAC mapping is added.

terminology "Body Mass Index Observations":
- valueset is ``.

// "Virtual Encounter Class" — source CQL uses the ActCode 'VR' code directly
// (not a valueset). Declared here as system+code terminology.
terminology "Virtual Encounter Class":
- system is `http://terminology.hl7.org/CodeSystem/v3-ActCode`.
- code is `VR`.

terminology "Pregnancy Status":
- valueset is ``.

terminology "Follow Up for Above Normal BMI Procedures":
- valueset is ``.

terminology "Follow Up for Below Normal BMI Procedures":
- valueset is ``.


// ============ Runtime stubs ============
// "Measurement Period" is a runtime CQL parameter, not a valueset.
// Kept as a stub asserted concept (coded from an empty stub valueset)
// until `parameter` declarations land (issues/crl/todo/parameters/).

terminology "Measurement Period (stub valueset)":
- valueset is ``.

concept "Measurement Period":
- type is Encounter.
- coded from "Measurement Period (stub valueset)".

// "Pregnancy or Other Related Diagnoses" is a valueset (declared above)
// referenced as a classification argument in `documented as` narrative.
// Declared as a concept wrapper so the narrative ref resolver finds it.
// Future: catalog signature for DocumentedAs may distinguish valueset args
// from concept args directly.
concept "Pregnancy or Other Related Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Pregnancy or Other Related Diagnoses".


// ============ Asserted concepts (unchanged) ============

concept "BMI Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Body Mass Index Observations".

concept "Pregnancy Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Pregnancy or Other Related Diagnoses".

concept "Pregnancy Status Observations":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Pregnancy Status".

concept "Overweight or Obese Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Overweight or Obese".

concept "Underweight Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Underweight".

concept "Encounters to Evaluate BMI":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Encounter to Evaluate BMI".

concept "Virtual Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Virtual Encounter Class".

concept "High BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI".

concept "Low BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI".

concept "Weight Assessment Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referrals Where Weight Assessment May Occur".

concept "High BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Above Normal BMI".

concept "Low BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Below Normal BMI".

concept "High BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI Procedures".

concept "Low BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI Procedures".

concept "Medical Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Medical Reason".

concept "Patient Declined Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Patient Declined".


// ============ Lifted property concepts (bare ref — type-only wrappers) ============

concept "High BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Service Requests".

concept "Weight Assessment Referral Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Weight Assessment Referrals".

concept "High BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "High BMI Medications".

concept "Low BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Service Requests".

concept "Low BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "Low BMI Medications".

concept "High BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Procedures".

concept "Low BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Procedures".


// ============ Inference declarations + composing concepts ============

// --- Qualifying Encounter ---

concept "BMI Evaluation Encounter (not virtual)":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Encounters to Evaluate BMI"
   sem-and
   sem-not "Virtual Encounters"
).

concept "BMI Evaluation Encounter (not virtual) During MP":
- type is Observation.
- valuetype is boolean.
- logic is "BMI Evaluation Encounter (not virtual)" during "Measurement Period".

concept "BMI Evaluation Encounter (not virtual) Performed":
- type is Observation.
- valuetype is boolean.
- logic is "BMI Evaluation Encounter (not virtual)" performed.

concept "Qualifying Encounter":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "BMI Evaluation Encounter (not virtual) During MP"
   sem-and
   "BMI Evaluation Encounter (not virtual) Performed"
).


// --- BMI During Measurement Period ---

concept "BMI Observation During MP":
- type is Observation.
- valuetype is Quantity.
- logic is "BMI Observations" during "Measurement Period".

concept "BMI Observation Has Positive Value":
- type is Observation.
- valuetype is Quantity.
- logic is "BMI Observations" exceeds 0 'kg/m2'.

concept "BMI During Measurement Period":
- type is Observation.
- valuetype is Quantity.
- inferred from
(
   "BMI Observation During MP"
   sem-and
   "BMI Observation Has Positive Value"
).


// --- BMI clinical classifications ---

concept "BMI During MP Is Low":
- type is Observation.
- valuetype is boolean.
- logic is "BMI During Measurement Period" is low.

concept "BMI During MP Is High":
- type is Observation.
- valuetype is boolean.
- logic is "BMI During Measurement Period" is high.

concept "BMI During MP Is Normal":
- type is Observation.
- valuetype is boolean.
- logic is "BMI During Measurement Period" is normal.

concept "Documented Low BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is Low".

concept "Documented High BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is High".

concept "Normal BMI Range":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is Normal".


// --- Has Normal BMI ---

concept "Without Documented Abnormal BMI":
- type is Observation.
- valuetype is boolean.
- logic is without documented ("Documented High BMI" or "Documented Low BMI").

concept "Has Normal BMI":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Normal BMI Range"
   sem-and
   "Without Documented Abnormal BMI"
).


// --- Co-existing diagnoses ---

concept "Overweight or Obese Diagnoses is Active":
- type is Observation.
- valuetype is boolean.
- logic is "Overweight or Obese Diagnoses" is active.

concept "Underweight Diagnoses is Active":
- type is Observation.
- valuetype is boolean.
- logic is "Underweight Diagnoses" is active.

concept "Has Overweight or Obese":
- type is Observation.
- valuetype is boolean.
- inferred from "Overweight or Obese Diagnoses is Active".

concept "Has Underweight":
- type is Observation.
- valuetype is boolean.
- inferred from "Underweight Diagnoses is Active".


// --- High BMI Interventions Ordered ---

concept "High BMI Follow-up Justified by Overweight Diagnosis":
- type is Observation.
- valuetype is boolean.
- logic is "High BMI Follow-up Service Requests" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Follow-up Order":
- type is Observation.
- valuetype is boolean.
- logic is "Has Overweight or Obese" on or before "High BMI Follow-up Order Date".

concept "High BMI Follow-up Order":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Follow-up Order"
).

concept "Weight Assessment Referral Justified by Overweight Diagnosis":
- type is Observation.
- valuetype is boolean.
- logic is "Weight Assessment Referrals" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before Weight Assessment Referral":
- type is Observation.
- valuetype is boolean.
- logic is "Has Overweight or Obese" on or before "Weight Assessment Referral Date".

concept "High BMI Weight Assessment Referral":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Weight Assessment Referral Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before Weight Assessment Referral"
).

concept "High BMI Medication Justified by Overweight Diagnosis":
- type is Observation.
- valuetype is boolean.
- logic is "High BMI Medications" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Medication Order":
- type is Observation.
- valuetype is boolean.
- logic is "Has Overweight or Obese" on or before "High BMI Medication Order Date".

concept "High BMI Medication Order":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI Medication Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Medication Order"
).

concept "High BMI Interventions Ordered":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Order"
   sem-or
   "High BMI Weight Assessment Referral"
   sem-or
   "High BMI Medication Order"
).


// --- High BMI Interventions Performed ---

concept "High BMI Procedure Justified by Overweight Diagnosis":
- type is Observation.
- valuetype is boolean.
- logic is "High BMI Follow-up Procedures" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Procedure":
- type is Observation.
- valuetype is boolean.
- logic is "Has Overweight or Obese" on or before "High BMI Procedure Performed Date".

concept "High BMI Procedure Performed":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI Procedure Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Procedure"
).

concept "High BMI Interventions Performed":
- type is Observation.
- valuetype is boolean.
- inferred from "High BMI Procedure Performed".


// --- High BMI And Follow Up Provided ---

concept "Documented High BMI During MP":
- type is Observation.
- valuetype is boolean.
- logic is "Documented High BMI" during "Measurement Period".

concept "High BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Documented High BMI During MP"
   sem-and
   (
      "High BMI Interventions Ordered"
      sem-or
      "High BMI Interventions Performed"
   )
).


// --- Low BMI analogous ---

concept "Low BMI Follow-up Justified by Underweight Diagnosis":
