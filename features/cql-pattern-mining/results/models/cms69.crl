# CMS69 BMI Screening and Follow-Up


// --- Source observations ---
concept "BMI Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Body Mass Index Observations".

// --- Diagnosis sources ---
concept "Pregnancy Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Pregnancy or Other Related Diagnoses".

concept "Pregnancy Status Observations":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Pregnancy Status".

concept "Overweight or Obese Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Overweight or Obese".

concept "Underweight Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Underweight".

// --- Encounter source ---
concept "Encounters to Evaluate BMI":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Encounter to Evaluate BMI".

concept "Virtual Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Virtual Encounter Class".

// --- Intervention sources: service requests ---
concept "High BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI".

concept "Low BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI".

concept "Weight Assessment Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referrals Where Weight Assessment May Occur".

// --- Intervention sources: medications ---
concept "High BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Above Normal BMI".

concept "Low BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Below Normal BMI".

// --- Intervention sources: procedures ---
concept "High BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI Procedures".

concept "Low BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI Procedures".

// --- Not-done reason qualifiers ---
concept "Medical Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Medical Reason".

concept "Patient Declined Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Patient Declined".


// --- Qualifying Encounter ---
concept "BMI Evaluation Encounter (not virtual)":
- type is Encounter.
- valuetype is boolean.
- inferred from ("Encounters to Evaluate BMI" and not "Virtual Encounters").

concept "Qualifying Encounter":
- type is Encounter.
- valuetype is boolean.
- inferred from "BMI Evaluation Encounter (not virtual)".
- apply pattern `During("BMI Evaluation Encounter (not virtual)", "Measurement Period") and WasPerformed("BMI Evaluation Encounter (not virtual)")`.

// --- BMI observations during MP ---
concept "BMI During Measurement Period":
- type is Observation.
- valuetype is Quantity.
- inferred from "BMI Observations".
- apply pattern `During("BMI Observations", "Measurement Period") and Exceeds("BMI Observations".value, 0 'kg/m2')`.

// --- BMI clinical classifications ---
// Standard cutoffs: <18.5 = Low, [18.5,25) = Normal, >=25 = High.
concept "Documented Low BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `Low("BMI During Measurement Period")`.

concept "Documented High BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `High("BMI During Measurement Period")`.

concept "Normal BMI Range":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `Normal("BMI During Measurement Period")`.

concept "Has Normal BMI":
- type is Observation.
- valuetype is boolean.
- inferred from ("Normal BMI Range" and not ("Documented High BMI" or "Documented Low BMI")).

// --- Co-existing diagnoses ---
concept "Has Overweight or Obese":
- type is Condition.
- valuetype is boolean.
- inferred from "Overweight or Obese Diagnoses".
- apply pattern `Active("Overweight or Obese Diagnoses")`.

concept "Has Underweight":
- type is Condition.
- valuetype is boolean.
- inferred from "Underweight Diagnoses".
- apply pattern `Active("Underweight Diagnoses")`.

// --- High BMI Interventions Ordered ---
concept "High BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "High BMI Follow-up Service Requests".
- apply pattern `Justified("High BMI Follow-up Service Requests", "Overweight or Obese Diagnoses") or OnOrBefore("Has Overweight or Obese", "High BMI Follow-up Service Requests".authoredOn)`.

concept "High BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `Justified("Weight Assessment Referrals", "Overweight or Obese Diagnoses") or OnOrBefore("Has Overweight or Obese", "Weight Assessment Referrals".authoredOn)`.

concept "High BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "High BMI Medications".
- apply pattern `Justified("High BMI Medications", "Overweight or Obese Diagnoses") or OnOrBefore("Has Overweight or Obese", "High BMI Medications".authoredOn)`.

concept "High BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("High BMI Follow-up Order" or "High BMI Weight Assessment Referral" or "High BMI Medication Order").

// --- High BMI Interventions Performed ---
concept "High BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "High BMI Follow-up Procedures".
- apply pattern `Justified("High BMI Follow-up Procedures", "Overweight or Obese Diagnoses") or OnOrBefore("Has Overweight or Obese", "High BMI Follow-up Procedures".performed)`.

concept "High BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "High BMI Procedure Performed".

// --- High BMI With Follow-Up Provided ---
concept "High BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from "Documented High BMI".
- apply pattern `With("Documented High BMI", ("High BMI Interventions Ordered" or "High BMI Interventions Performed") and During("Documented High BMI", "Measurement Period"))`.

// --- Low BMI analogous ---
concept "Low BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Service Requests".
- apply pattern `Justified("Low BMI Follow-up Service Requests", "Underweight Diagnoses") or (OnOrBefore("Has Underweight", "Low BMI Follow-up Service Requests".authoredOn) and During("Low BMI Follow-up Service Requests".authoredOn, "Measurement Period"))`.

concept "Low BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `Justified("Weight Assessment Referrals", "Underweight Diagnoses") or (OnOrBefore("Has Underweight", "Weight Assessment Referrals".authoredOn) and During("Weight Assessment Referrals".authoredOn, "Measurement Period"))`.

concept "Low BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Low BMI Medications".
- apply pattern `Justified("Low BMI Medications", "Underweight Diagnoses") or (OnOrBefore("Has Underweight", "Low BMI Medications".authoredOn) and During("Low BMI Medications".authoredOn, "Measurement Period"))`.

concept "Low BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("Low BMI Follow-up Order" or "Low BMI Weight Assessment Referral" or "Low BMI Medication Order").

concept "Low BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Procedures".
- apply pattern `(Justified("Low BMI Follow-up Procedures", "Underweight Diagnoses") and WasPerformed("Low BMI Follow-up Procedures")) or (OnOrBefore("Has Underweight", "Low BMI Follow-up Procedures".performed) and During("Low BMI Follow-up Procedures".performed, "Measurement Period"))`.

concept "Low BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "Low BMI Procedure Performed".

concept "Low BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from "Documented Low BMI".
- apply pattern `With("Documented Low BMI", ("Low BMI Interventions Ordered" or "Low BMI Interventions Performed") and During("Documented Low BMI", "Measurement Period"))`.

// --- BMI exam not performed with reason ---
concept "Medical Reason Or Patient Reason For Not Performing BMI Exam":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI Observations".
- apply pattern `NotDoneWithReason("BMI Observations", "Medical Reasons" or "Patient Declined Reasons") and SameDay("BMI Observations", "Qualifying Encounter")`.

// --- BMI follow-up not documented with reason ---
concept "High BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "High BMI Follow-up Service Requests".
- apply pattern `NotDoneWithReason("High BMI Follow-up Service Requests", "Medical Reasons") and SameDay("High BMI Follow-up Service Requests", "Qualifying Encounter") and WasPerformed("High BMI Follow-up Service Requests")`.

concept "Low BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Service Requests".
- apply pattern `NotDoneWithReason("Low BMI Follow-up Service Requests", "Medical Reasons") and SameDay("Low BMI Follow-up Service Requests", "Qualifying Encounter") and WasPerformed("Low BMI Follow-up Service Requests")`.

concept "Weight Assessment Referral Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `NotDoneWithReason("Weight Assessment Referrals", "Medical Reasons") and SameDay("Weight Assessment Referrals", "Qualifying Encounter") and WasPerformed("Weight Assessment Referrals")`.

concept "High BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "High BMI Medications".
- apply pattern `NotDoneWithReason("High BMI Medications", "Medical Reasons") and SameDay("High BMI Medications", "Qualifying Encounter") and WasPerformed("High BMI Medications")`.

concept "Low BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Low BMI Medications".
- apply pattern `NotDoneWithReason("Low BMI Medications", "Medical Reasons") and SameDay("Low BMI Medications", "Qualifying Encounter") and WasPerformed("Low BMI Medications")`.

concept "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("High BMI Follow-up Not Done With Reason"
                or "Low BMI Follow-up Not Done With Reason"
                or "Weight Assessment Referral Not Done With Reason"
                or "High BMI Medication Not Done With Reason"
                or "Low BMI Medication Not Done With Reason").

// --- Pregnancy during measurement period ---
concept "Active Pregnancy Diagnosis":
- type is Condition.
- valuetype is boolean.
- inferred from "Pregnancy Diagnoses".
- apply pattern `Active("Pregnancy Diagnoses", during "Measurement Period")`.

concept "Verified Pregnancy Status":
- type is Observation.
- valuetype is boolean.
- inferred from "Pregnancy Status Observations".
- apply pattern `Overlaps("Pregnancy Status Observations", "Measurement Period") and Verified("Pregnancy Status Observations") and DocumentedAs("Pregnancy Status Observations", "Pregnancy or Other Related Diagnoses")`.

concept "Is Pregnant During Measurement Period":
- type is Condition.
- valuetype is boolean.
- inferred from ("Active Pregnancy Diagnosis" or "Verified Pregnancy Status").

// --- Age predicate ---
concept "Aged 18+ at Qualifying Encounter":
- type is Encounter.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `AtLeast(AgeAt(start of "Qualifying Encounter"), 18 years)`.


// --- Measure API ---
concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- inferred from "Aged 18+ at Qualifying Encounter".

concept "Denominator":
- type is Encounter.
- valuetype is boolean.
- inferred from "Initial Population".

concept "Denominator Exclusions":
- type is Condition.
- valuetype is boolean.
- inferred from "Is Pregnant During Measurement Period".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- inferred from ("High BMI And Follow Up Provided" or "Low BMI And Follow Up Provided" or "Has Normal BMI").

concept "Denominator Exceptions":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI" or "Medical Reason Or Patient Reason For Not Performing BMI Exam").
