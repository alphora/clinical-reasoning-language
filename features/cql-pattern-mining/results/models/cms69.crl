# CMS69 BMI Screening and Follow-Up


// --- Source observations ---
concept "BMI Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Body Mass Index Observations".

// --- Diagnosis sources ---
concept "Pregnancy Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Pregnancy or Other Related Diagnoses".

concept "Pregnancy Status Observations":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Pregnancy Status".

concept "Overweight or Obese Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Overweight or Obese".

concept "Underweight Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Underweight".

// --- Encounter source ---
concept "Encounters to Evaluate BMI":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Encounter to Evaluate BMI".

concept "Virtual Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Virtual Encounter Class".

// --- Intervention sources: service requests ---
concept "High BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI".

concept "Low BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI".

concept "Weight Assessment Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referrals Where Weight Assessment May Occur".

// --- Intervention sources: medications ---
concept "High BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Above Normal BMI".

concept "Low BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Below Normal BMI".

// --- Intervention sources: procedures ---
concept "High BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI Procedures".

concept "Low BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI Procedures".

// --- Not-done reason qualifiers ---
concept "Medical Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Medical Reason".

concept "Patient Declined Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Patient Declined".


// --- Qualifying Encounter ---
concept "BMI Evaluation Encounter (not virtual)":
- type is Encounter.
- valuetype is boolean.
- inferred from ("Encounters to Evaluate BMI" and not "Virtual Encounters").

concept "Qualifying Encounter":
- type is Encounter.
- valuetype is boolean.
- inferred from "BMI Evaluation Encounter (not virtual)".
- apply pattern `"BMI Evaluation Encounter (not virtual)" during "Measurement Period" and "BMI Evaluation Encounter (not virtual)" was performed`.

// --- BMI observations during MP ---
concept "BMI During Measurement Period":
- type is Observation.
- valuetype is Quantity.
- inferred from "BMI Observations".
- apply pattern `"BMI Observations" during "Measurement Period" and "BMI Observations" exceeds 0 'kg/m2'`.

// --- BMI clinical classifications ---
// Standard cutoffs: <18.5 = Low, [18.5,25) = Normal, >=25 = High.
concept "Documented Low BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `"BMI During Measurement Period" is low`.

concept "Documented High BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `"BMI During Measurement Period" is high`.

concept "Normal BMI Range":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During Measurement Period".
- apply pattern `"BMI During Measurement Period" is normal`.

concept "Has Normal BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "Normal BMI Range".
- apply pattern `without documented ("Documented High BMI" or "Documented Low BMI")`.

// --- Co-existing diagnoses ---
concept "Has Overweight or Obese":
- type is Condition.
- valuetype is boolean.
- inferred from "Overweight or Obese Diagnoses".
- apply pattern `"Overweight or Obese Diagnoses" is active`.

concept "Has Underweight":
- type is Condition.
- valuetype is boolean.
- inferred from "Underweight Diagnoses".
- apply pattern `"Underweight Diagnoses" is active`.

// --- Lifted property concepts (order/performed dates per source action) ---
concept "High BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Service Requests".

concept "Weight Assessment Referral Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Weight Assessment Referrals".

concept "High BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "High BMI Medications".

concept "Low BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Service Requests".

concept "Low BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "Low BMI Medications".

concept "High BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Procedures".

concept "Low BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Procedures".

// --- High BMI Interventions Ordered ---
concept "High BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "High BMI Follow-up Service Requests".
- apply pattern `"High BMI Follow-up Service Requests" justified by "Overweight or Obese Diagnoses" or "Has Overweight or Obese" on or before "High BMI Follow-up Order Date"`.

concept "High BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `"Weight Assessment Referrals" justified by "Overweight or Obese Diagnoses" or "Has Overweight or Obese" on or before "Weight Assessment Referral Date"`.

concept "High BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "High BMI Medications".
- apply pattern `"High BMI Medications" justified by "Overweight or Obese Diagnoses" or "Has Overweight or Obese" on or before "High BMI Medication Order Date"`.

concept "High BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("High BMI Follow-up Order" or "High BMI Weight Assessment Referral" or "High BMI Medication Order").

// --- High BMI Interventions Performed ---
concept "High BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "High BMI Follow-up Procedures".
- apply pattern `"High BMI Follow-up Procedures" justified by "Overweight or Obese Diagnoses" or "Has Overweight or Obese" on or before "High BMI Procedure Performed Date"`.

concept "High BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "High BMI Procedure Performed".

// --- High BMI With Follow-Up Provided ---
concept "High BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from "Documented High BMI".
- apply pattern `"Documented High BMI" with (("High BMI Interventions Ordered" or "High BMI Interventions Performed") and "Documented High BMI" during "Measurement Period")`.

// --- Low BMI analogous ---
concept "Low BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Service Requests".
- apply pattern `"Low BMI Follow-up Service Requests" justified by "Underweight Diagnoses" or ("Has Underweight" on or before "Low BMI Follow-up Order Date" and "Low BMI Follow-up Order Date" during "Measurement Period")`.

concept "Low BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `"Weight Assessment Referrals" justified by "Underweight Diagnoses" or ("Has Underweight" on or before "Weight Assessment Referral Date" and "Weight Assessment Referral Date" during "Measurement Period")`.

concept "Low BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Low BMI Medications".
- apply pattern `"Low BMI Medications" justified by "Underweight Diagnoses" or ("Has Underweight" on or before "Low BMI Medication Order Date" and "Low BMI Medication Order Date" during "Measurement Period")`.

concept "Low BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("Low BMI Follow-up Order" or "Low BMI Weight Assessment Referral" or "Low BMI Medication Order").

concept "Low BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Procedures".
- apply pattern `("Low BMI Follow-up Procedures" justified by "Underweight Diagnoses" and "Low BMI Follow-up Procedures" was performed) or ("Has Underweight" on or before "Low BMI Procedure Performed Date" and "Low BMI Procedure Performed Date" during "Measurement Period")`.

concept "Low BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "Low BMI Procedure Performed".

concept "Low BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from "Documented Low BMI".
- apply pattern `"Documented Low BMI" with (("Low BMI Interventions Ordered" or "Low BMI Interventions Performed") and "Documented Low BMI" during "Measurement Period")`.

// --- BMI exam not performed with reason ---
concept "Medical Reason Or Patient Reason For Not Performing BMI Exam":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI Observations".
- apply pattern `"BMI Observations" not done with reason ("Medical Reasons" or "Patient Declined Reasons") and "BMI Observations" same day as "Qualifying Encounter"`.

// --- BMI follow-up not documented with reason ---
concept "High BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "High BMI Follow-up Service Requests".
- apply pattern `"High BMI Follow-up Service Requests" not done with reason "Medical Reasons" and "High BMI Follow-up Service Requests" same day as "Qualifying Encounter" and "High BMI Follow-up Service Requests" was performed`.

concept "Low BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Low BMI Follow-up Service Requests".
- apply pattern `"Low BMI Follow-up Service Requests" not done with reason "Medical Reasons" and "Low BMI Follow-up Service Requests" same day as "Qualifying Encounter" and "Low BMI Follow-up Service Requests" was performed`.

concept "Weight Assessment Referral Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Weight Assessment Referrals".
- apply pattern `"Weight Assessment Referrals" not done with reason "Medical Reasons" and "Weight Assessment Referrals" same day as "Qualifying Encounter" and "Weight Assessment Referrals" was performed`.

concept "High BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "High BMI Medications".
- apply pattern `"High BMI Medications" not done with reason "Medical Reasons" and "High BMI Medications" same day as "Qualifying Encounter" and "High BMI Medications" was performed`.

concept "Low BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Low BMI Medications".
- apply pattern `"Low BMI Medications" not done with reason "Medical Reasons" and "Low BMI Medications" same day as "Qualifying Encounter" and "Low BMI Medications" was performed`.

concept "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("High BMI Follow-up Not Done With Reason"
                or "Low BMI Follow-up Not Done With Reason"
                or "Weight Assessment Referral Not Done With Reason"
                or "High BMI Medication Not Done With Reason"
                or "Low BMI Medication Not Done With Reason").

// --- Pregnancy during measurement period ---
concept "Active Pregnancy Diagnosis":
- type is Condition.
- valuetype is boolean.
- inferred from "Pregnancy Diagnoses".
- apply pattern `"Pregnancy Diagnoses" is active during "Measurement Period"`.

concept "Verified Pregnancy Status":
- type is Observation.
- valuetype is boolean.
- inferred from "Pregnancy Status Observations".
- apply pattern `"Pregnancy Status Observations" overlaps "Measurement Period" and "Pregnancy Status Observations" is verified and "Pregnancy Status Observations" documented as "Pregnancy or Other Related Diagnoses"`.

concept "Is Pregnant During Measurement Period":
- type is Condition.
- valuetype is boolean.
- inferred from ("Active Pregnancy Diagnosis" or "Verified Pregnancy Status").

// --- Age predicate ---
concept "Aged 18+ at Measurement Period Start":
- type is Encounter.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `age at start of "Measurement Period" at least 18 years`.


// --- Measure API ---
concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- inferred from "Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Encounter.
- valuetype is boolean.
- inferred from "Initial Population".

concept "Denominator Exclusions":
- type is Condition.
- valuetype is boolean.
- inferred from "Is Pregnant During Measurement Period".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- inferred from ("High BMI And Follow Up Provided" or "Low BMI And Follow Up Provided" or "Has Normal BMI").

concept "Denominator Exceptions":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from ("Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI" or "Medical Reason Or Patient Reason For Not Performing BMI Exam").
