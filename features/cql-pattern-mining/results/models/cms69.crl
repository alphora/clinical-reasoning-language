(
   "Low BMI Medication Justified by Underweight Diagnosis"
   sem-or
   (
      "Has Underweight On Or Before Low BMI Medication Order"
      sem-and
      "Low BMI Medication Order Date During MP"
   )
).

concept "Low BMI Interventions Ordered":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Low BMI Follow-up Order"
   sem-or
   "Low BMI Weight Assessment Referral"
   sem-or
   "Low BMI Medication Order"
).


// --- Low BMI Interventions Performed ---

concept "Low BMI Procedure Justified by Underweight Diagnosis":
- type is Observation.
- valuetype is boolean.
- logic is "Low BMI Follow-up Procedures" justified by "Underweight Diagnoses".

concept "Low BMI Follow-up Procedures Performed":
- type is Observation.
- valuetype is boolean.
- logic is "Low BMI Follow-up Procedures" performed.

concept "Has Underweight On Or Before Low BMI Procedure":
- type is Observation.
- valuetype is boolean.
- logic is "Has Underweight" on or before "Low BMI Procedure Performed Date".

concept "Low BMI Procedure Performed Date During MP":
- type is Observation.
- valuetype is boolean.
- logic is "Low BMI Procedure Performed Date" during "Measurement Period".

concept "Low BMI Procedure Performed":
- type is Observation.
- valuetype is boolean.
