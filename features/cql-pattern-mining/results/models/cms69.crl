// --- Pregnancy during measurement period ---

concept "Pregnancy Diagnoses Active During MP":
- type is Observation.
- valuetype is boolean.
- logic is "Pregnancy Diagnoses" is active during "Measurement Period".

concept "Active Pregnancy Diagnosis":
- type is Observation.
- valuetype is boolean.
- inferred from "Pregnancy Diagnoses Active During MP".

concept "Pregnancy Status Overlaps MP":
- type is Observation.
- valuetype is boolean.
- logic is "Pregnancy Status Observations" overlaps "Measurement Period".

concept "Pregnancy Status Is Verified":
- type is Observation.
- valuetype is boolean.
- logic is "Pregnancy Status Observations" is verified.

concept "Pregnancy Status Documented As Pregnancy Related":
- type is Observation.
- valuetype is boolean.
- logic is "Pregnancy Status Observations" documented as "Pregnancy or Other Related Diagnoses".

concept "Verified Pregnancy Status":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Pregnancy Status Overlaps MP"
   sem-and
   "Pregnancy Status Is Verified"
   sem-and
   "Pregnancy Status Documented As Pregnancy Related"
).

concept "Is Pregnant During Measurement Period":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Active Pregnancy Diagnosis"
   sem-or
   "Verified Pregnancy Status"
).


// --- Age predicate ---

concept "Age At Start Of MP At Least 18 Years":
- type is Observation.
- valuetype is boolean.
- logic is age at start of "Measurement Period" at least 18 years.

concept "Aged 18+ at Measurement Period Start":
- type is Observation.
- valuetype is boolean.
- inferred from "Age At Start Of MP At Least 18 Years".


// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- inferred from "Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Observation.
- valuetype is boolean.
- inferred from "Initial Population".

concept "Denominator Exclusions":
- type is Observation.
- valuetype is boolean.
- inferred from "Is Pregnant During Measurement Period".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI And Follow Up Provided"
   sem-or
   "Low BMI And Follow Up Provided"
   sem-or
   "Has Normal BMI"
).

concept "Denominator Exceptions":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI"
   sem-or
   "Medical Reason Or Patient Reason For Not Performing BMI Exam"
).
