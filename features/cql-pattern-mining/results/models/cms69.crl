concept "Has Underweight On Or Before Low BMI Medication Order":
- type is Observation.
- valuetype is boolean.
- logic is "Has Underweight" on or before "Low BMI Medication Order Date".

concept "Low BMI Medication Order Date During MP":
- type is Observation.
- valuetype is boolean.
