# CMS69 BMI Screening and Follow-Up — v0.6 grammar

// Migrated to CRL v0.6: `concept` is the only declaration kind; `logic is` body for narrative predicates;
// concept `inferred from` body is bare ref or sem-or/sem-and/sem-not composition.
// All multi-clause concepts now compose named inferences via sem-* operators.


// ============ Runtime / valueset stubs ============
// Temporary asserted-concept stubs for refs that don't resolve locally.
// "Measurement Period" will become a parameter declaration when imports +
// parameters land (issues/crl/todo/imports/, issues/crl/todo/parameters/).
// "Pregnancy or Other Related Diagnoses" is a valueset ref used by the
// `documented as` pattern; classification valueset refs need their own
// reference rules (deferred).
// Asserted bodies skip narrative ref checking — stubs satisfy resolution
// without cascading more errors.

concept "Measurement Period":
- type is Encounter.
- coded from "Measurement Period (stub valueset)".

concept "Pregnancy or Other Related Diagnoses":
- type is Condition.
- coded from "Pregnancy or Other Related Diagnoses (stub valueset)".


// ============ Asserted concepts (unchanged) ============

concept "BMI Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Body Mass Index Observations".

concept "Pregnancy Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Pregnancy or Other Related Diagnoses".

concept "Pregnancy Status Observations":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Pregnancy Status".

concept "Overweight or Obese Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Overweight or Obese".

concept "Underweight Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Underweight".

concept "Encounters to Evaluate BMI":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Encounter to Evaluate BMI".

concept "Virtual Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Virtual Encounter Class".

concept "High BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI".

concept "Low BMI Follow-up Service Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI".

concept "Weight Assessment Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referrals Where Weight Assessment May Occur".

concept "High BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Above Normal BMI".

concept "Low BMI Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Medications for Below Normal BMI".

concept "High BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Above Normal BMI Procedures".

concept "Low BMI Follow-up Procedures":
- type is Procedure.
- valuetype is CodeableConcept.
- coded from "Follow Up for Below Normal BMI Procedures".

concept "Medical Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Medical Reason".

concept "Patient Declined Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Patient Declined".


// ============ Lifted property concepts (bare ref — type-only wrappers) ============

concept "High BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Service Requests".

concept "Weight Assessment Referral Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Weight Assessment Referrals".

concept "High BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "High BMI Medications".

concept "Low BMI Follow-up Order Date":
- type is ServiceRequest.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Service Requests".

concept "Low BMI Medication Order Date":
- type is MedicationRequest.
- valuetype is dateTime.
- inferred from "Low BMI Medications".

concept "High BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "High BMI Follow-up Procedures".

concept "Low BMI Procedure Performed Date":
- type is Procedure.
- valuetype is dateTime.
- inferred from "Low BMI Follow-up Procedures".


// ============ Inference declarations + composing concepts ============

// --- Qualifying Encounter ---

concept "BMI Evaluation Encounter (not virtual)":
- type is Encounter.
- valuetype is boolean.
- inferred from
(
   "Encounters to Evaluate BMI"
   sem-and
   sem-not "Virtual Encounters"
).

concept "BMI Evaluation Encounter (not virtual) During MP":
- logic is "BMI Evaluation Encounter (not virtual)" during "Measurement Period".

concept "BMI Evaluation Encounter (not virtual) Performed":
- logic is "BMI Evaluation Encounter (not virtual)" performed.

concept "Qualifying Encounter":
- type is Encounter.
- valuetype is boolean.
- inferred from
(
   "BMI Evaluation Encounter (not virtual) During MP"
   sem-and
   "BMI Evaluation Encounter (not virtual) Performed"
).


// --- BMI During Measurement Period ---

concept "BMI Observation During MP":
- logic is "BMI Observations" during "Measurement Period".

concept "BMI Observation Has Positive Value":
- logic is "BMI Observations" exceeds 0 'kg/m2'.

concept "BMI During Measurement Period":
- type is Observation.
- valuetype is Quantity.
- inferred from
(
   "BMI Observation During MP"
   sem-and
   "BMI Observation Has Positive Value"
).


// --- BMI clinical classifications ---

concept "BMI During MP Is Low":
- logic is "BMI During Measurement Period" is low.

concept "BMI During MP Is High":
- logic is "BMI During Measurement Period" is high.

concept "BMI During MP Is Normal":
- logic is "BMI During Measurement Period" is normal.

concept "Documented Low BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is Low".

concept "Documented High BMI":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is High".

concept "Normal BMI Range":
- type is Observation.
- valuetype is boolean.
- inferred from "BMI During MP Is Normal".


// --- Has Normal BMI ---

concept "Without Documented Abnormal BMI":
- logic is without documented ("Documented High BMI" or "Documented Low BMI").

concept "Has Normal BMI":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Normal BMI Range"
   sem-and
   "Without Documented Abnormal BMI"
).


// --- Co-existing diagnoses ---

concept "Overweight or Obese Diagnoses is Active":
- logic is "Overweight or Obese Diagnoses" is active.

concept "Underweight Diagnoses is Active":
- logic is "Underweight Diagnoses" is active.

concept "Has Overweight or Obese":
- type is Condition.
- valuetype is boolean.
- inferred from "Overweight or Obese Diagnoses is Active".

concept "Has Underweight":
- type is Condition.
- valuetype is boolean.
- inferred from "Underweight Diagnoses is Active".


// --- High BMI Interventions Ordered ---

concept "High BMI Follow-up Justified by Overweight Diagnosis":
- logic is "High BMI Follow-up Service Requests" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Follow-up Order":
- logic is "Has Overweight or Obese" on or before "High BMI Follow-up Order Date".

concept "High BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Follow-up Order"
).

concept "Weight Assessment Referral Justified by Overweight Diagnosis":
- logic is "Weight Assessment Referrals" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before Weight Assessment Referral":
- logic is "Has Overweight or Obese" on or before "Weight Assessment Referral Date".

concept "High BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Weight Assessment Referral Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before Weight Assessment Referral"
).

concept "High BMI Medication Justified by Overweight Diagnosis":
- logic is "High BMI Medications" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Medication Order":
- logic is "Has Overweight or Obese" on or before "High BMI Medication Order Date".

concept "High BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Medication Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Medication Order"
).

concept "High BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Order"
   sem-or
   "High BMI Weight Assessment Referral"
   sem-or
   "High BMI Medication Order"
).


// --- High BMI Interventions Performed ---

concept "High BMI Procedure Justified by Overweight Diagnosis":
- logic is "High BMI Follow-up Procedures" justified by "Overweight or Obese Diagnoses".

concept "Has Overweight On Or Before High BMI Procedure":
- logic is "Has Overweight or Obese" on or before "High BMI Procedure Performed Date".

concept "High BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from
(
   "High BMI Procedure Justified by Overweight Diagnosis"
   sem-or
   "Has Overweight On Or Before High BMI Procedure"
).

concept "High BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "High BMI Procedure Performed".


// --- High BMI And Follow Up Provided ---

concept "Documented High BMI During MP":
- logic is "Documented High BMI" during "Measurement Period".

concept "High BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Documented High BMI During MP"
   sem-and
   (
      "High BMI Interventions Ordered"
      sem-or
      "High BMI Interventions Performed"
   )
).


// --- Low BMI analogous ---

concept "Low BMI Follow-up Justified by Underweight Diagnosis":
- logic is "Low BMI Follow-up Service Requests" justified by "Underweight Diagnoses".

concept "Has Underweight On Or Before Low BMI Follow-up Order":
- logic is "Has Underweight" on or before "Low BMI Follow-up Order Date".

concept "Low BMI Follow-up Order Date During MP":
- logic is "Low BMI Follow-up Order Date" during "Measurement Period".

concept "Low BMI Follow-up Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Low BMI Follow-up Justified by Underweight Diagnosis"
   sem-or
   (
      "Has Underweight On Or Before Low BMI Follow-up Order"
      sem-and
      "Low BMI Follow-up Order Date During MP"
   )
).

concept "Weight Assessment Referral Justified by Underweight Diagnosis":
- logic is "Weight Assessment Referrals" justified by "Underweight Diagnoses".

concept "Has Underweight On Or Before Weight Assessment Referral":
- logic is "Has Underweight" on or before "Weight Assessment Referral Date".

concept "Weight Assessment Referral Date During MP":
- logic is "Weight Assessment Referral Date" during "Measurement Period".

concept "Low BMI Weight Assessment Referral":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Weight Assessment Referral Justified by Underweight Diagnosis"
   sem-or
   (
      "Has Underweight On Or Before Weight Assessment Referral"
      sem-and
      "Weight Assessment Referral Date During MP"
   )
).

concept "Low BMI Medication Justified by Underweight Diagnosis":
- logic is "Low BMI Medications" justified by "Underweight Diagnoses".

concept "Has Underweight On Or Before Low BMI Medication Order":
- logic is "Has Underweight" on or before "Low BMI Medication Order Date".

concept "Low BMI Medication Order Date During MP":
- logic is "Low BMI Medication Order Date" during "Measurement Period".

concept "Low BMI Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from
(
   "Low BMI Medication Justified by Underweight Diagnosis"
   sem-or
   (
      "Has Underweight On Or Before Low BMI Medication Order"
      sem-and
      "Low BMI Medication Order Date During MP"
   )
).

concept "Low BMI Interventions Ordered":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Low BMI Follow-up Order"
   sem-or
   "Low BMI Weight Assessment Referral"
   sem-or
   "Low BMI Medication Order"
).


// --- Low BMI Interventions Performed ---

concept "Low BMI Procedure Justified by Underweight Diagnosis":
- logic is "Low BMI Follow-up Procedures" justified by "Underweight Diagnoses".

concept "Low BMI Follow-up Procedures Performed":
- logic is "Low BMI Follow-up Procedures" performed.

concept "Has Underweight On Or Before Low BMI Procedure":
- logic is "Has Underweight" on or before "Low BMI Procedure Performed Date".

concept "Low BMI Procedure Performed Date During MP":
- logic is "Low BMI Procedure Performed Date" during "Measurement Period".

concept "Low BMI Procedure Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from
(
   (
      "Low BMI Procedure Justified by Underweight Diagnosis"
      sem-and
      "Low BMI Follow-up Procedures Performed"
   )
   sem-or
   (
      "Has Underweight On Or Before Low BMI Procedure"
      sem-and
      "Low BMI Procedure Performed Date During MP"
   )
).

concept "Low BMI Interventions Performed":
- type is Procedure.
- valuetype is boolean.
- inferred from "Low BMI Procedure Performed".


// --- Low BMI And Follow Up Provided ---

concept "Documented Low BMI During MP":
- logic is "Documented Low BMI" during "Measurement Period".

concept "Low BMI And Follow Up Provided":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Documented Low BMI During MP"
   sem-and
   (
      "Low BMI Interventions Ordered"
      sem-or
      "Low BMI Interventions Performed"
   )
).


// --- BMI exam not performed with reason ---

concept "BMI Observation Not Done With Reason":
- logic is "BMI Observations" not done with reason ("Medical Reasons" or "Patient Declined Reasons").

concept "BMI Observation Same Day As Qualifying Encounter":
- logic is "BMI Observations" same day as "Qualifying Encounter".

concept "Medical Reason Or Patient Reason For Not Performing BMI Exam":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "BMI Observation Not Done With Reason"
   sem-and
   "BMI Observation Same Day As Qualifying Encounter"
).


// --- BMI follow-up not documented with reason ---

concept "High BMI Follow-up Not Done With Medical Reason":
- logic is "High BMI Follow-up Service Requests" not done with reason "Medical Reasons".

concept "High BMI Follow-up Same Day As Qualifying Encounter":
- logic is "High BMI Follow-up Service Requests" same day as "Qualifying Encounter".

concept "High BMI Follow-up Performed":
- logic is "High BMI Follow-up Service Requests" performed.

concept "High BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Not Done With Medical Reason"
   sem-and
   "High BMI Follow-up Same Day As Qualifying Encounter"
   sem-and
   "High BMI Follow-up Performed"
).

concept "Low BMI Follow-up Not Done With Medical Reason":
- logic is "Low BMI Follow-up Service Requests" not done with reason "Medical Reasons".

concept "Low BMI Follow-up Same Day As Qualifying Encounter":
- logic is "Low BMI Follow-up Service Requests" same day as "Qualifying Encounter".

concept "Low BMI Follow-up Performed":
- logic is "Low BMI Follow-up Service Requests" performed.

concept "Low BMI Follow-up Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Low BMI Follow-up Not Done With Medical Reason"
   sem-and
   "Low BMI Follow-up Same Day As Qualifying Encounter"
   sem-and
   "Low BMI Follow-up Performed"
).

concept "Weight Assessment Referral Not Done With Medical Reason":
- logic is "Weight Assessment Referrals" not done with reason "Medical Reasons".

concept "Weight Assessment Referral Same Day As Qualifying Encounter":
- logic is "Weight Assessment Referrals" same day as "Qualifying Encounter".

concept "Weight Assessment Referral Performed":
- logic is "Weight Assessment Referrals" performed.

concept "Weight Assessment Referral Not Done With Reason":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Weight Assessment Referral Not Done With Medical Reason"
   sem-and
   "Weight Assessment Referral Same Day As Qualifying Encounter"
   sem-and
   "Weight Assessment Referral Performed"
).

concept "High BMI Medication Not Done With Medical Reason":
- logic is "High BMI Medications" not done with reason "Medical Reasons".

concept "High BMI Medication Same Day As Qualifying Encounter":
- logic is "High BMI Medications" same day as "Qualifying Encounter".

concept "High BMI Medication Performed":
- logic is "High BMI Medications" performed.

concept "High BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Medication Not Done With Medical Reason"
   sem-and
   "High BMI Medication Same Day As Qualifying Encounter"
   sem-and
   "High BMI Medication Performed"
).

concept "Low BMI Medication Not Done With Medical Reason":
- logic is "Low BMI Medications" not done with reason "Medical Reasons".

concept "Low BMI Medication Same Day As Qualifying Encounter":
- logic is "Low BMI Medications" same day as "Qualifying Encounter".

concept "Low BMI Medication Performed":
- logic is "Low BMI Medications" performed.

concept "Low BMI Medication Not Done With Reason":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from
(
   "Low BMI Medication Not Done With Medical Reason"
   sem-and
   "Low BMI Medication Same Day As Qualifying Encounter"
   sem-and
   "Low BMI Medication Performed"
).

concept "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "High BMI Follow-up Not Done With Reason"
   sem-or
   "Low BMI Follow-up Not Done With Reason"
   sem-or
   "Weight Assessment Referral Not Done With Reason"
   sem-or
   "High BMI Medication Not Done With Reason"
   sem-or
   "Low BMI Medication Not Done With Reason"
).


// --- Pregnancy during measurement period ---

concept "Pregnancy Diagnoses Active During MP":
- logic is "Pregnancy Diagnoses" is active during "Measurement Period".

concept "Active Pregnancy Diagnosis":
- type is Condition.
- valuetype is boolean.
- inferred from "Pregnancy Diagnoses Active During MP".

concept "Pregnancy Status Overlaps MP":
- logic is "Pregnancy Status Observations" overlaps "Measurement Period".

concept "Pregnancy Status Is Verified":
- logic is "Pregnancy Status Observations" is verified.

concept "Pregnancy Status Documented As Pregnancy Related":
- logic is "Pregnancy Status Observations" documented as "Pregnancy or Other Related Diagnoses".

concept "Verified Pregnancy Status":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "Pregnancy Status Overlaps MP"
   sem-and
   "Pregnancy Status Is Verified"
   sem-and
   "Pregnancy Status Documented As Pregnancy Related"
).

concept "Is Pregnant During Measurement Period":
- type is Condition.
- valuetype is boolean.
- inferred from
(
   "Active Pregnancy Diagnosis"
   sem-or
   "Verified Pregnancy Status"
).


// --- Age predicate ---

concept "Age At Start Of MP At Least 18 Years":
- logic is age at start of "Measurement Period" at least 18 years.

concept "Aged 18+ at Measurement Period Start":
- type is Encounter.
- valuetype is boolean.
- inferred from "Age At Start Of MP At Least 18 Years".


// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- inferred from "Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Encounter.
- valuetype is boolean.
- inferred from "Initial Population".

concept "Denominator Exclusions":
- type is Condition.
- valuetype is boolean.
- inferred from "Is Pregnant During Measurement Period".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- inferred from
(
   "High BMI And Follow Up Provided"
   sem-or
   "Low BMI And Follow Up Provided"
   sem-or
   "Has Normal BMI"
).

concept "Denominator Exceptions":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from
(
   "Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI"
   sem-or
   "Medical Reason Or Patient Reason For Not Performing BMI Exam"
).
