# CMS22 Blood Pressure Screening and Follow-Up
library "CMS22".
include "CMS22 Inferred".

// The unsuffixed file is the Quality Measure interface layer
// (IP / Denom / Numerator / Exclusions / Exceptions — what the Measure
// evaluation engine consumes). Asserted concepts, inferred derivations,
// and terminology live in cms22-asserted.crl / cms22-inferred.crl /
// cms22-terminology.crl.

// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- defined as "Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Observation.
- valuetype is boolean.
- defined as "Initial Population".

concept "Denominator Exclusions":
- type is Observation.
- valuetype is boolean.
- defined as "Verified Hypertension As Of Qualifying Encounter".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "Normal BP Reading"
   sem-or
   "Elevated BP With Followup"
   sem-or
   "First HTN With Followup"
   sem-or
   "Second HTN 130s With Followup"
   sem-or
   "Second HTN 140+ With Followup"
).

concept "Denominator Exceptions":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "BP Measurement Not Done With Reason"
   sem-or
   "HTN Followup Declined By Patient"
).
