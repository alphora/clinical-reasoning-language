# CMS22 Blood Pressure Screening and Follow-Up
library "CMS22".

// The unsuffixed file is the Quality Measure interface layer
// (IP / Denom / Numerator / Exclusions / Exceptions — what the Measure
// evaluation engine consumes). Asserted concepts, inferred derivations,
// and terminology live in cms22-asserted.crl / cms22-inferred.crl /
// cms22-terminology.crl.

// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- defined as "CMS22 Inferred"."Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Observation.
- valuetype is boolean.
- defined as "Initial Population".

concept "Denominator Exclusions":
- type is Observation.
- valuetype is boolean.
- defined as "CMS22 Inferred"."Verified Hypertension As Of Qualifying Encounter".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "CMS22 Inferred"."Normal BP Reading"
   sem-or
   "CMS22 Inferred"."Elevated BP With Followup"
   sem-or
   "CMS22 Inferred"."First HTN With Followup"
   sem-or
   "CMS22 Inferred"."Second HTN 130s With Followup"
   sem-or
   "CMS22 Inferred"."Second HTN 140+ With Followup"
).

concept "Denominator Exceptions":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "CMS22 Inferred"."BP Measurement Not Done With Reason"
   sem-or
   "CMS22 Inferred"."HTN Followup Declined By Patient"
).
