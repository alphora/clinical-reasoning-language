# CMS22 Blood Pressure Screening and Follow-Up


// --- Encounter source ---
concept "BP Screening Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Encounter to Screen for Blood Pressure".

concept "Virtual Encounters":
- type is Encounter.
- valuetype is CodeableConcept.
- coded from "Virtual Encounter Class".

// --- Diagnosis source ---
concept "Hypertension Diagnoses":
- type is Condition.
- valuetype is CodeableConcept.
- coded from "Diagnosis of Hypertension".

// --- BP observation source ---
concept "Blood Pressure Panels":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Blood pressure panel with all children optional".

concept "Systolic Blood Pressure Code":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Systolic Blood Pressure Code".

concept "Diastolic Blood Pressure Code":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Diastolic Blood Pressure Code".

// --- Standalone Systolic / Diastolic observations (for cancellation branches) ---
concept "Standalone Systolic BP Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Systolic Blood Pressure Code".

concept "Standalone Diastolic BP Observations":
- type is Observation.
- valuetype is Quantity.
- coded from "Diastolic Blood Pressure Code".

// --- Intervention sources: follow-up service requests ---
concept "Follow-up Within 4 Weeks":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up Within 4 Weeks".

concept "Follow-up Within 6 Months":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Follow Up Within 6 Months".

// --- Intervention sources: lifestyle / non-pharmacological ---
concept "Lifestyle Recommendations":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Lifestyle Recommendation".

concept "Weight Reduction Recommendations":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Weight Reduction Recommended".

concept "Dietary Recommendations":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Dietary Recommendations".

concept "Physical Activity Recommendations":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Recommendation to Increase Physical Activity".

concept "Alcohol Counseling Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referral or Counseling for Alcohol Consumption".

// --- Intervention sources: referral / lab / pharmacological ---
concept "Primary-Care Referrals":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Referral to Primary Care or Alternate Provider".

concept "Hypertension Lab Tests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "Laboratory Tests for Hypertension".

concept "EKG 12-Lead Panel Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "EKG 12 Lead Panel Code".

concept "EKG Study Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- coded from "EKG Study Code".

concept "Antihypertensive Medications":
- type is MedicationRequest.
- valuetype is CodeableConcept.
- coded from "Pharmacologic Therapy for Hypertension".

// --- Hypertensive-reading finding (reason qualifier) ---
concept "Hypertensive Reading Findings":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Finding of Elevated Blood Pressure or Hypertension".

// --- Not-done reason qualifiers ---
concept "Medical Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Medical Reason".

concept "Patient Declined Reasons":
- type is Observation.
- valuetype is CodeableConcept.
- coded from "Patient Declined".


// --- Qualifying Encounter ---
concept "BP Evaluation Encounter (not virtual)":
- type is Encounter.
- valuetype is boolean.
- inferred from ("BP Screening Encounters" and not "Virtual Encounters").

concept "Qualifying Encounter":
- type is Encounter.
- valuetype is boolean.
- inferred from "BP Evaluation Encounter (not virtual)".
- apply pattern `During("BP Evaluation Encounter (not virtual)", "Measurement Period") and WasPerformed("BP Evaluation Encounter (not virtual)")`.

// --- BP panel projections (Systolic / Diastolic) ---
concept "Systolic BP Reading":
- type is Observation.
- valuetype is Quantity.
- inferred from "Blood Pressure Panels".
- apply pattern `Component("Blood Pressure Panels", "Systolic Blood Pressure Code")`.

concept "Diastolic BP Reading":
- type is Observation.
- valuetype is Quantity.
- inferred from "Blood Pressure Panels".
- apply pattern `Component("Blood Pressure Panels", "Diastolic Blood Pressure Code")`.

// --- Last BP reading on each qualifying encounter day ---
concept "Last BP Panel on Qualifying Encounter Day":
- type is Observation.
- valuetype is CodeableConcept.
- inferred from "Blood Pressure Panels".
- apply pattern `Last("Blood Pressure Panels", on day of "Qualifying Encounter")`.

concept "Last Systolic on Qualifying Encounter Day":
- type is Observation.
- valuetype is Quantity.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `Component("Last BP Panel on Qualifying Encounter Day", "Systolic Blood Pressure Code")`.

concept "Last Diastolic on Qualifying Encounter Day":
- type is Observation.
- valuetype is Quantity.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `Component("Last BP Panel on Qualifying Encounter Day", "Diastolic Blood Pressure Code")`.

// --- BP classification ladder ---
// Normal:           Systolic < 120 AND Diastolic < 80
// Elevated:         Systolic 120–129 AND Diastolic < 80
// First HTN:        Systolic >= 130 OR Diastolic >= 80, with no prior-year HTN reading
// Second HTN 130s:  Systolic 130–139 OR Diastolic 80–89, with prior-year HTN reading
// Second HTN 140+:  Systolic >= 140 OR Diastolic >= 90, with prior-year HTN reading
concept "Normal BP Reading":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `Below("Last Systolic on Qualifying Encounter Day".value, 120 'mm[Hg]') and Below("Last Diastolic on Qualifying Encounter Day".value, 80 'mm[Hg]')`.

concept "Elevated BP Reading":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `Between("Last Systolic on Qualifying Encounter Day".value, 120 'mm[Hg]', 129 'mm[Hg]') and Below("Last Diastolic on Qualifying Encounter Day".value, 80 'mm[Hg]')`.

concept "Hypertensive Reading":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `AtLeast("Last Systolic on Qualifying Encounter Day".value, 130 'mm[Hg]') or AtLeast("Last Diastolic on Qualifying Encounter Day".value, 80 'mm[Hg]')`.

concept "Last BP Panel Within Year Prior to Qualifying Encounter":
- type is Observation.
- valuetype is CodeableConcept.
- inferred from "Blood Pressure Panels".
- apply pattern `Last("Blood Pressure Panels", in 1 year before start of "Qualifying Encounter")`.

concept "Prior-Year Last Systolic":
- type is Observation.
- valuetype is Quantity.
- inferred from "Last BP Panel Within Year Prior to Qualifying Encounter".
- apply pattern `Component("Last BP Panel Within Year Prior to Qualifying Encounter", "Systolic Blood Pressure Code")`.

concept "Prior-Year Last Diastolic":
- type is Observation.
- valuetype is Quantity.
- inferred from "Last BP Panel Within Year Prior to Qualifying Encounter".
- apply pattern `Component("Last BP Panel Within Year Prior to Qualifying Encounter", "Diastolic Blood Pressure Code")`.

concept "Prior-Year Hypertensive Reading":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel Within Year Prior to Qualifying Encounter".
- apply pattern `AtLeast("Prior-Year Last Systolic".value, 130 'mm[Hg]') or AtLeast("Prior-Year Last Diastolic".value, 80 'mm[Hg]')`.

concept "First Hypertensive Reading":
- type is Observation.
- valuetype is boolean.
- inferred from ("Hypertensive Reading" and not "Prior-Year Hypertensive Reading").

concept "Second Hypertensive Reading 130s Body":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `(Between("Last Systolic on Qualifying Encounter Day".value, 130 'mm[Hg]', 139 'mm[Hg]') or Between("Last Diastolic on Qualifying Encounter Day".value, 80 'mm[Hg]', 89 'mm[Hg]')) and not (AtLeast("Last Systolic on Qualifying Encounter Day".value, 140 'mm[Hg]') or AtLeast("Last Diastolic on Qualifying Encounter Day".value, 90 'mm[Hg]'))`.

concept "Second Hypertensive Reading 130s":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 130s Body" and "Prior-Year Hypertensive Reading").

concept "Second Hypertensive Reading 140+ Body":
- type is Observation.
- valuetype is boolean.
- inferred from "Last BP Panel on Qualifying Encounter Day".
- apply pattern `AtLeast("Last Systolic on Qualifying Encounter Day".value, 140 'mm[Hg]') or AtLeast("Last Diastolic on Qualifying Encounter Day".value, 90 'mm[Hg]')`.

concept "Second Hypertensive Reading 140+":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 140+ Body" and "Prior-Year Hypertensive Reading").

// --- Ordered-intervention concepts ---
concept "Four-Week Rescreen Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Follow-up Within 4 Weeks".
- apply pattern `WasOrdered("Follow-up Within 4 Weeks")`.

concept "Six-Month Rescreen Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Follow-up Within 6 Months".
- apply pattern `WasOrdered("Follow-up Within 6 Months")`.

concept "Non-Pharmacological Recommendations":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- inferred from ("Lifestyle Recommendations" or "Weight Reduction Recommendations" or "Dietary Recommendations" or "Physical Activity Recommendations" or "Alcohol Counseling Referrals").

concept "Non-Pharmacological Recommendation Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Non-Pharmacological Recommendations".
- apply pattern `WasOrdered("Non-Pharmacological Recommendations")`.

concept "Hypertension Lab or ECG Requests":
- type is ServiceRequest.
- valuetype is CodeableConcept.
- inferred from ("EKG 12-Lead Panel Requests" or "EKG Study Requests" or "Hypertension Lab Tests").

concept "Hypertension Lab or ECG Order":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Hypertension Lab or ECG Requests".
- apply pattern `WasOrdered("Hypertension Lab or ECG Requests")`.

concept "Antihypertensive Medication Order":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Antihypertensive Medications".
- apply pattern `WasOrdered("Antihypertensive Medications")`.

concept "Referral for Hypertensive Reading":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Primary-Care Referrals".
- apply pattern `Justified("Primary-Care Referrals", "Hypertensive Reading Findings") and WasOrdered("Primary-Care Referrals")`.

// --- Per-class intervention bundles ---
// Elevated BP: 6-month rescreen + non-pharm, OR a referral.
concept "Elevated BP Followup Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Six-Month Rescreen Order", "Qualifying Encounter") and SameDay("Non-Pharmacological Recommendation Order", "Qualifying Encounter")) or SameDay("Referral for Hypertensive Reading", "Qualifying Encounter")`.

// First HTN: 4-week rescreen + non-pharm, OR a referral.
concept "First HTN Followup Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Four-Week Rescreen Order", "Qualifying Encounter") and SameDay("Non-Pharmacological Recommendation Order", "Qualifying Encounter")) or SameDay("Referral for Hypertensive Reading", "Qualifying Encounter")`.

// Second HTN 130s: 6-month rescreen + lab/ECG + non-pharm, OR a referral.
concept "Second HTN 130s Followup Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Six-Month Rescreen Order", "Qualifying Encounter") and SameDay("Hypertension Lab or ECG Order", "Qualifying Encounter") and SameDay("Non-Pharmacological Recommendation Order", "Qualifying Encounter")) or SameDay("Referral for Hypertensive Reading", "Qualifying Encounter")`.

// Second HTN 140+: 4-week rescreen + lab/ECG + non-pharm + antihypertensive med, OR a referral.
concept "Second HTN 140+ Followup Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Four-Week Rescreen Order", "Qualifying Encounter") and SameDay("Hypertension Lab or ECG Order", "Qualifying Encounter") and SameDay("Non-Pharmacological Recommendation Order", "Qualifying Encounter") and SameDay("Antihypertensive Medication Order", "Qualifying Encounter")) or SameDay("Referral for Hypertensive Reading", "Qualifying Encounter")`.

// --- Per-class numerator components ---
// Each = ReadingClass AND (intervention bundle for that class). Normal counts on its own.
concept "Elevated BP With Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Elevated BP Reading" and "Elevated BP Followup Bundle").

concept "First HTN With Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("First Hypertensive Reading" and "First HTN Followup Bundle").

concept "Second HTN 130s With Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 130s" and "Second HTN 130s Followup Bundle").

concept "Second HTN 140+ With Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 140+" and "Second HTN 140+ Followup Bundle").

// --- Verified hypertension diagnosis established by encounter day (Denominator Exclusion driver) ---
// Source CQL: prevalenceInterval() starts before or on day of encounter.period AND isVerified().
// Note: .prevalenceStart denotes the emitter-resolved prevalence-interval start (not raw onset).
concept "Verified Hypertension Established By Qualifying Encounter":
- type is Condition.
- valuetype is boolean.
- inferred from "Hypertension Diagnoses".
- apply pattern `Verified("Hypertension Diagnoses") and OnOrBefore("Hypertension Diagnoses".prevalenceStart, "Qualifying Encounter")`.

// --- Exception branch 1: BP measurement not done with documented reason ---
// Covers cancellation of the BP panel OR a standalone systolic OR a standalone diastolic observation,
// with notDoneReason in (Medical Reason OR Patient Declined), same day as the qualifying encounter.
concept "BP Measurement Sources":
- type is Observation.
- valuetype is CodeableConcept.
- inferred from ("Blood Pressure Panels" or "Standalone Systolic BP Observations" or "Standalone Diastolic BP Observations").

concept "BP Measurement Not Done With Reason":
- type is Observation.
- valuetype is boolean.
- inferred from "BP Measurement Sources".
- apply pattern `NotDoneWithReason("BP Measurement Sources", "Medical Reasons" or "Patient Declined Reasons") and SameDay("BP Measurement Sources", "Qualifying Encounter")`.

// --- Exception branch 2: HTN follow-up declined by patient ---
concept "Four-Week Rescreen Declined":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Follow-up Within 4 Weeks".
- apply pattern `NotDoneWithReason("Follow-up Within 4 Weeks", "Patient Declined Reasons")`.

concept "Six-Month Rescreen Declined":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Follow-up Within 6 Months".
- apply pattern `NotDoneWithReason("Follow-up Within 6 Months", "Patient Declined Reasons")`.

concept "Primary-Care Referral Declined":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Primary-Care Referrals".
- apply pattern `NotDoneWithReason("Primary-Care Referrals", "Patient Declined Reasons")`.

concept "Non-Pharm Recommendation Declined":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Non-Pharmacological Recommendations".
- apply pattern `NotDoneWithReason("Non-Pharmacological Recommendations", "Patient Declined Reasons")`.

concept "Hypertension Lab or ECG Declined":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Hypertension Lab or ECG Requests".
- apply pattern `NotDoneWithReason("Hypertension Lab or ECG Requests", "Patient Declined Reasons")`.

concept "Antihypertensive Medication Declined":
- type is MedicationRequest.
- valuetype is boolean.
- inferred from "Antihypertensive Medications".
- apply pattern `NotDoneWithReason("Antihypertensive Medications", "Patient Declined Reasons")`.

concept "Elevated BP Declined Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Primary-Care Referral Declined", "Qualifying Encounter") or SameDay("Six-Month Rescreen Declined", "Qualifying Encounter")) or SameDay("Non-Pharm Recommendation Declined", "Qualifying Encounter")`.

concept "First HTN Declined Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Four-Week Rescreen Declined", "Qualifying Encounter") or SameDay("Primary-Care Referral Declined", "Qualifying Encounter")) or SameDay("Non-Pharm Recommendation Declined", "Qualifying Encounter")`.

concept "Second HTN 130s Declined Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Primary-Care Referral Declined", "Qualifying Encounter") or SameDay("Six-Month Rescreen Declined", "Qualifying Encounter")) or SameDay("Hypertension Lab or ECG Declined", "Qualifying Encounter") or SameDay("Non-Pharm Recommendation Declined", "Qualifying Encounter")`.

concept "Second HTN 140+ Declined Bundle":
- type is ServiceRequest.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `(SameDay("Primary-Care Referral Declined", "Qualifying Encounter") or SameDay("Four-Week Rescreen Declined", "Qualifying Encounter")) or SameDay("Antihypertensive Medication Declined", "Qualifying Encounter") or SameDay("Hypertension Lab or ECG Declined", "Qualifying Encounter") or SameDay("Non-Pharm Recommendation Declined", "Qualifying Encounter")`.

concept "Elevated BP With Declined Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Elevated BP Reading" and "Elevated BP Declined Bundle").

concept "First HTN With Declined Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("First Hypertensive Reading" and "First HTN Declined Bundle").

concept "Second HTN 130s With Declined Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 130s" and "Second HTN 130s Declined Bundle").

concept "Second HTN 140+ With Declined Followup":
- type is Observation.
- valuetype is boolean.
- inferred from ("Second Hypertensive Reading 140+" and "Second HTN 140+ Declined Bundle").

concept "HTN Followup Declined By Patient":
- type is Observation.
- valuetype is boolean.
- inferred from ("Elevated BP With Declined Followup"
                or "First HTN With Declined Followup"
                or "Second HTN 130s With Declined Followup"
                or "Second HTN 140+ With Declined Followup").

// --- Age predicate ---
concept "Aged 18+ at Measurement Period Start":
- type is Encounter.
- valuetype is boolean.
- inferred from "Qualifying Encounter".
- apply pattern `AtLeast(AgeAt(start of "Measurement Period"), 18 years)`.


// --- Measure API ---
concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- inferred from "Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Encounter.
- valuetype is boolean.
- inferred from "Initial Population".

concept "Denominator Exclusions":
- type is Condition.
- valuetype is boolean.
- inferred from "Verified Hypertension Established By Qualifying Encounter".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- inferred from ("Normal BP Reading"
                or "Elevated BP With Followup"
                or "First HTN With Followup"
                or "Second HTN 130s With Followup"
                or "Second HTN 140+ With Followup").

concept "Denominator Exceptions":
- type is Observation.
- valuetype is boolean.
- inferred from ("BP Measurement Not Done With Reason" or "HTN Followup Declined By Patient").
