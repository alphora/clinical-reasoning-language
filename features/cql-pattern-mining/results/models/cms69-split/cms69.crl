# CMS69 BMI Screening and Follow-Up
library "CMS69".
include "CMS69 Inferred".

// The unsuffixed file is the Quality Measure interface layer
// (IP / Denom / Numerator / Exclusions / Exceptions — what the Measure
// evaluation engine consumes). Asserted concepts, inferred derivations,
// and terminology live in cms69-asserted.crl / cms69-inferred.crl /
// cms69-terminology.crl.

// ============ Measure API ============

concept "Initial Population":
- type is Observation.
- valuetype is boolean.
- defined as "CMS69 Inferred"."Aged 18+ at Measurement Period Start".

concept "Denominator":
- type is Observation.
- valuetype is boolean.
- defined as "Initial Population".

concept "Denominator Exclusions":
- type is Observation.
- valuetype is boolean.
- defined as "CMS69 Inferred"."Is Pregnant During Measurement Period".

concept "Numerator":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "CMS69 Inferred"."High BMI And Follow Up Provided"
   sem-or
   "CMS69 Inferred"."Low BMI And Follow Up Provided"
   sem-or
   "CMS69 Inferred"."Has Normal BMI"
).

concept "Denominator Exceptions":
- type is Observation.
- valuetype is boolean.
- defined as
(
   "CMS69 Inferred"."Medical Reason For Not Documenting A Follow Up Plan For Low Or High BMI"
   sem-or
   "CMS69 Inferred"."Medical Reason Or Patient Reason For Not Performing BMI Exam"
).
